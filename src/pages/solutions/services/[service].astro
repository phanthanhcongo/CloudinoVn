            "Chiến lược Cloud phải trực tiếp hỗ trợ tăng trưởng doanh thu, cải thiện trải nghiệm khách hàng và tối ưu hóa vận hành. Mọi triển khai kỹ thuật cần có chỉ số đo lường (KPI) liên quan đến hiệu quả kinh doanh.",
        },
        {
          question:
            "Làm thế nào để đánh giá mức độ sẵn sàng của hệ thống trước khi chuyển đổi lên Cloud?",
          answer:
            'Thực hiện "Cloud Readiness Assessment" để kiểm tra tính tương thích, phụ thuộc của dữ liệu và ứng dụng. Đảm bảo đội ngũ nhân sự đã sẵn sàng về kỹ năng vận hành trên môi trường mới.',
        },
        {
          question:
            "Doanh nghiệp nên xây dựng Cloud Roadmap theo những giai đoạn nào?",
          answer:
            "Lộ trình nên chia thành các giai đoạn: Đánh giá & Lập kế hoạch, Thử nghiệm (Pilot), Chuyển đổi (Migration), Tối ưu hóa (Optimization) và Vận hành bền vững (Managed Services).",
        },
      ],
    },
  ];

  return services.map((s) => ({
    params: { service: s.service },
    props: {
      title: s.title,
      heroDesc: s.heroDesc,
      trustedTitle: s.trustedTitle,
      pillars: s.pillars,
      faqList: s.faqList,
    },
  }));
}

