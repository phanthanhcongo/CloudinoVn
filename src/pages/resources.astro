---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader";
import CaseStoriesSection from "../components/CaseStoriesSection.astro";
import { insights } from "../data/insights";
---

<Layout title="Resources | Cloudino">
  <main class="bg-black">
    {/* Hero Section */}
    <section
      class="relative flex min-h-[450px] sm:min-h-[600px] md:min-h-[750px] lg:h-[900px] items-center justify-center overflow-hidden bg-[#080511] pt-[80px] md:pt-[100px] pb-12 sm:pb-16"
    >
      {/* Background Vertical Stripes */}
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:40px_100%] sm:bg-[size:60px_100%] pointer-events-none opacity-50 z-0"
      >
      </div>

      {/* Background Starry Noise */}
      <img
        src="/images/backgrounds/image119.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover mix-blend-lighten opacity-60 pointer-events-none brightness-150"
      />

      {/* Glowing Purple Ambient Orb in Center */}
      <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[220px] w-[220px] sm:h-[340px] sm:w-[340px] md:h-[450px] md:w-[450px] lg:h-[520px] lg:w-[520px] rounded-full bg-gradient-to-tr from-[#312E81] via-[#6D28D9] to-[#EC4899] opacity-40 blur-[80px] pointer-events-none z-0"
      >
      </div>

      {/* Centered Orbit Ring Container */}
      <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] h-[320px] sm:w-[480px] sm:h-[480px] md:w-[620px] md:h-[620px] lg:w-[740px] lg:h-[740px] aspect-square pointer-events-none z-10 flex items-center justify-center"
      >
        {/* Dashed Orbit Ring */}
        <div
          class="absolute left-1/2 top-1/2 h-full w-full rounded-full border border-dashed border-purple-300/40 animate-spin-slow"
        >
          <div
            class="absolute top-[10%] left-[22%] -translate-x-1/2 -translate-y-1/2 h-4 w-4 rounded-full bg-[#fee2e2] border-2 border-white shadow-[0_0_14px_#ffffff]"
          >
          </div>
          <div
            class="absolute top-[50%] right-[0%] translate-x-1/2 -translate-y-1/2 h-4 w-4 rounded-full bg-[#fee2e2] border-2 border-white shadow-[0_0_14px_#ffffff]"
          >
          </div>
          <div
            class="absolute bottom-[8%] left-[38%] translate-x-1/2 translate-y-1/2 h-3.5 w-3.5 rounded-full border border-white/70 bg-white/20 backdrop-blur-sm"
          >
          </div>
        </div>

        {/* 3D Floating Objects Anchored Directly On Orbit Ring Curve */}
        <div
          class="absolute top-[30%] left-[4%] -translate-x-1/4 -translate-y-1/4 animate-float"
          style={{ animationDelay: "1s" }}
        >
          <img
            src="/images/resources/nut-3d.png"
            alt="3D Ring Nut"
            class="h-[75px] w-[75px] sm:h-[120px] sm:w-[120px] md:h-[155px] md:w-[155px] lg:h-[180px] lg:w-[180px] object-contain rotate-[10deg] filter drop-shadow-[0_15px_30px_rgba(125,81,211,0.6)]"
          />
        </div>

        <div
          class="absolute top-[30%] right-[4%] translate-x-1/4 -translate-y-1/4 animate-float"
          style={{ animationDelay: "0s" }}
        >
          <img
            src="/images/resources/cone-3d.png"
            alt="3D Cone"
            class="h-[75px] w-[75px] sm:h-[125px] sm:w-[125px] md:h-[160px] md:w-[160px] lg:h-[190px] lg:w-[190px] object-contain filter drop-shadow-[0_15px_30px_rgba(125,81,211,0.6)]"
            style={{ transform: "rotate(120deg)" }}
          />
        </div>

        <div
          class="absolute bottom-[4%] left-[4%] -translate-x-1/4 translate-y-1/4 animate-float"
          style={{ animationDelay: "1.5s" }}
        >
          <img
            src="/images/resources/blob-3d.png"
            alt="3D Liquid Blob"
            class="h-[80px] w-[80px] sm:h-[130px] sm:w-[130px] md:h-[165px] md:w-[165px] lg:h-[195px] lg:w-[195px] object-contain -rotate-6 filter drop-shadow-[0_15px_30px_rgba(125,81,211,0.6)]"
          />
        </div>

        <div
          class="absolute bottom-[4%] right-[4%] translate-x-1/4 translate-y-1/4 animate-float"
          style={{ animationDelay: "2s" }}
        >
          <img
            src="/images/resources/star-3d.png"
            alt="3D Star"
            class="h-[70px] w-[70px] sm:h-[115px] sm:w-[115px] md:h-[150px] md:w-[150px] lg:h-[175px] lg:w-[175px] object-contain rotate-12 filter drop-shadow-[0_15px_30px_rgba(125,81,211,0.6)]"
          />
        </div>
      </div>

      {/* Center Main Title */}
      <div
        class="relative z-10 mx-auto w-full max-w-[1920px] px-4 sm:px-8 md:px-12 lg:px-16 2xl:px-[285px] text-center"
      >
        <h1
          class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl 2xl:text-[104px] font-extrabold tracking-tight text-transparent bg-clip-text select-none leading-none"
          style="background-image: linear-gradient(135deg, #c7d2fe 0%, #e9d5ff 28%, #fef08a 55%, #fbcfe8 78%, #f472b6 100%); filter: drop-shadow(0 0 30px rgba(168,85,247,0.35));"
        >
          Resources
        </h1>
      </div>
    </section>

    {/* Case Stories Section */}
    <CaseStoriesSection />

    {/* Insights Grid Section */}
    <section id="insight" class="bg-black pt-4 sm:pt-6 pb-12 sm:pb-20 lg:pb-24">
      <div
        class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-12 lg:px-16 2xl:px-[285px]"
      >
        <SectionHeader title="Insights" leftPercent={0} client:load />

        <div
          class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8"
        >
          {
            insights.map((item) => (
              <a
                href={`/resources/${item.slug}`}
                class="group flex flex-col justify-between rounded-3xl border border-purple-500/20 p-5 sm:p-6 bg-purple-950/20 backdrop-blur-sm transition-all duration-300 hover:border-purple-400/60 hover:bg-purple-900/40 hover:-translate-y-1.5 shadow-[0_4px_20px_rgba(0,0,0,0.4)]"
              >
                <div>
                  <div class="flex items-center justify-between text-xs text-white/60 mb-3">
                    <span>{item.date}</span>
                    <span class="px-2.5 py-0.5 rounded-full bg-purple-900/60 text-purple-300 font-medium border border-purple-400/30">
                      {item.category}
                    </span>
                  </div>
                  <div class="aspect-video w-full overflow-hidden rounded-2xl">
                    <img
                      src={item.image}
                      alt={item.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                  <h3 class="mt-4 text-base sm:text-lg font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-2">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-xs sm:text-sm text-white/70 line-clamp-3">
                    {item.description}
                  </p>
                </div>
                <div class="mt-6 flex h-10 w-[140px] items-center justify-center rounded-full border border-purple-400/50 text-xs font-medium text-white backdrop-blur-xl bg-gradient-to-r from-[#312e81] via-[#5b3db5] to-[#7d51d3] group-hover:bg-white group-hover:text-[#201048] shadow-[0_0_15px_rgba(168,85,247,0.3)] transition-all duration-300">
                  XEM CHI TIẾT →
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
