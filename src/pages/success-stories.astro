---
import SuccessStoriesCardGrids from "../components/SuccessStoriesCardGrids";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Success Stories | Cloudino">
  <main class="bg-black">
    <section
      class="relative flex h-[930px] items-center overflow-hidden bg-black"
    >
      <img
        src="/images/backgrounds/M&M.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20 mix-blend-lighten"
      />
      <div
        class="relative mx-auto w-full max-w-[1920px] px-[285px] text-center"
      >
        <p class="text-2xl font-normal text-white">
          We accompany our customers on their innovation journey
        </p>
        <h1
          class="mt-4 mx-auto max-w-[1151px] text-[64px] font-bold leading-[1.5] text-transparent bg-clip-text"
          style="background-image:linear-gradient(45deg,#5B6FF5,#D4CB7B 52.6%,#DA3FF0)"
        >
          Explore cloudino&apos;s DX capabilities through customer success
          stories across industries
        </h1>
      </div>
    </section>

    <section class="bg-black pb-8">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="flex gap-4">
          {
            ["All", "Service", "Platform", "Industry"].map(tag => (
              <button class="flex flex-col items-start rounded-full border border-white/20 px-6 py-3 text-white/70 transition-all hover:border-white/40 hover:text-white">
                <span class="text-2xl font-normal">{tag}</span>
                <span class="text-base font-normal opacity-50">
                  Optimize cloud spending
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>
    <section class="relative overflow-hidden bg-black pt-[100px] pb-[55px]">
      <img
        src="/images/backgrounds/bg-section-6.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-60"
      />

      <div class="mb-[25px] flex items-center">
        <div
          class="relative flex items-center overflow-hidden rounded-full border border-accent px-6 py-3"
          style={{
            background: "rgba(49,46,129,0.25)",
            backdropFilter: "blur(16px)",
          }}
        >
          <div
            class="absolute left-0 top-1/2 -translate-x-1/2 -translate-y-1/2"
          >
            <div class="h-4 w-4 rounded-full bg-white opacity-30 blur-[2px]">
            </div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="h-2 w-2 rounded-full bg-white opacity-40"></div>
            </div>
          </div>
          <h2 class="text-5xl font-light text-white">Featured case stories</h2>
          <div
            class="absolute right-0 top-1/2 translate-x-1/2 -translate-y-1/2"
          >
            <div class="h-4 w-4 rounded-full bg-white opacity-30 blur-[2px]">
            </div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="h-2 w-2 rounded-full bg-white opacity-40"></div>
            </div>
          </div>
        </div>
        <div class="ml-0 flex-1 border-dashed border border-white/20"></div>
        <img
          src="/images/partners/logo-1.png"
          alt=""
          class="ml-0 h-[50px] w-[296px] object-contain"
        />
      </div>
      <SuccessStoriesCardGrids />
    </section>
    <section class="bg-black pb-8">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">All Case Stories(99)</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-3 gap-10">
          {
            Array.from({ length: 9 }, (_, i) => (
              <a href={`/success-stories/${i + 1}`} class="group w-[480px]">
                <div class="h-[440px] w-full overflow-hidden rounded-lg">
                  <img
                    src={`/images/backgrounds/deco-${(i % 8) + 1}.png`}
                    alt=""
                    class="h-full w-full object-cover"
                  />
                </div>
                <h3 class="mt-4 text-2xl font-bold text-white group-hover:text-primary">
                  lorem ipsum dolor sit amet consectet adipiscing elit sed diam
                </h3>
                <p class="mt-2 text-base font-normal text-white">
                  lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                  diam nonummy nibh euismod tincidunt ut
                </p>
                <div
                  class="mt-6 flex h-[60px] w-[194px] items-center justify-center rounded-full border border-white/20 text-xl font-normal tracking-[-1px] text-white backdrop-blur-md transition-all hover:bg-white hover:text-black"
                  style="background:rgba(255,255,255,0.05)"
                >
                  LEARN MORE →
                </div>
              </a>
            ))
          }
        </div>

        <div class="mt-12 flex items-center justify-center gap-6">
          <button
            class="text-5xl font-light text-white/40 hover:text-white transition-colors"
            >&larr;</button
          >
          {
            ["1", "2", "3", "4", "..."].map(p => (
              <button
                class={`text-2xl font-normal transition-colors ${p === "1" ? "text-white" : "text-white/40 hover:text-white"}`}
              >
                {p}
              </button>
            ))
          }
          <button
            class="text-5xl font-light text-white/40 hover:text-white transition-colors"
            >&rarr;</button
          >
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden bg-black pt-[100px] pb-[55px]">
      <img
        src="/images/backgrounds/bg-section-6.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-60"
      />
      <div class="relative mx-auto max-w-[1920px] px-[285px]">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">Featured Case Stories</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
      </div>
      <div class="relative mt-12 overflow-x-auto scrollbar-hide">
        <div class="flex" style="margin-left:-99px">
          {
            Array.from({ length: 8 }, (_, i) => (
              <a
                href="/success-stories"
                class="group relative block h-[897px] w-[265px] shrink-0 transition-all duration-300 hover:-translate-y-2"
              >
                <div
                  class="absolute bottom-0 left-0 right-0 flex items-end justify-center"
                  style="height:640px"
                >
                  <img
                    src={`/images/backgrounds/deco-${i + 1}.png`}
                    alt=""
                    class="h-[640px] w-[220px] rounded object-cover"
                  />
                </div>
                <div class="absolute right-0 top-0 h-full w-[91px] border-l border-white/[0.04]" />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">Certification</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
        <h2 class="text-5xl font-light text-white">
          Global Partnerships and Certifications
        </h2>
        <p class="mt-2 text-base font-normal text-white/70">
          We possess globally recognized technical expertise and service
          quality.
        </p>
        <div class="mt-12 grid grid-cols-4 gap-10">
          {
            Array.from({ length: 4 }, (_, i) => (
              <div class="flex w-[350px] flex-col items-center">
                <div class="flex h-[354px] w-[227px] items-center justify-center">
                  <img
                    src="/images/aws/aws-icon.png"
                    alt=""
                    class="h-[207px] w-[207px] object-contain opacity-60"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
