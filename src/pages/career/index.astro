---
import Layout from "../../layouts/Layout.astro";
import PurpleOrb from "../../components/PurpleOrb";
import WhyCloudinoCareer from "../../components/WhyCloudinoCareer";
import SectionHeader from "../../components/SectionHeader";

const positions = [
  {
    title: "Devops Engineer (Junior)",
    location: "Hà Nội",
    salary: "Thỏa thuận theo năng lực",
    link: "devops",
  },
  {
    title: "AI Engineer (Junior/Middle)",
    location: "Hà Nội",
    salary: "Thỏa thuận theo năng lực",
    link: "ai-engineer",
  },
  {
    title: "Cloud Engineer (Junior)",
    location: "Hà Nội",
    salary: "Thỏa thuận theo năng lực",
    link: "cloud-engineer",
  },
];
---

<Layout title="Career | Cloudino">
  <main class="pt-[66px] md:pt-[101px] bg-black min-h-screen">
    {/* Hero Section */}
    <section
      class="relative flex flex-col items-center overflow-hidden bg-[#080808] border-b border-accent/40 py-8 sm:py-12 md:py-16 px-4 sm:px-6"
    >
      {/* Background image 119 - LIGHTEN blend */}
      <img
        src="/images/backgrounds/image119.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover mix-blend-lighten pointer-events-none"
      />
      <div
        class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 text-center py-8 sm:py-12 md:py-16"
      >
        {/* Vibrant Purple Glow Orb centered directly behind Hero Title */}
        <PurpleOrb
          size={340}
          blur={110}
          opacity={0.8}
          className="sm:hidden pointer-events-none z-0"
        />
        <PurpleOrb
          size={650}
          blur={140}
          opacity={0.85}
          className="hidden sm:block pointer-events-none z-0"
        />

        <div class="relative z-10 mx-auto max-w-[740px]">
          <h1
            class="text-3xl sm:text-5xl md:text-7xl lg:text-8xl xl:text-[96px] font-bold leading-tight md:leading-none text-transparent bg-clip-text uppercase tracking-tight"
            style="background-image:linear-gradient(45deg,#5B6FF5,#D4CB7B 52.6%,#DA3FF0)"
          >
            Cơ hội nghề nghiệp
          </h1>
          <p
            class="mt-4 sm:mt-6 text-sm sm:text-lg md:text-2xl font-normal text-white/90 leading-relaxed sm:leading-normal"
          >
            Chúng tôi đang tìm kiếm những cộng sự cùng chia sẻ tầm nhìn: Đổi mới
            Tương lai, Cùng nhau kiến tạo. <br class="hidden sm:inline" /> Hãy trở
            thành một phần trong hành trình tiếp theo tại Cloudino.
          </p>
        </div>
      </div>
      <img
        src="/images/backgrounds/image 148.png"
        alt=""
        class="mx-auto my-8 sm:my-16 md:my-28 max-w-full h-auto object-contain px-4"
      />
    </section>

    {/* Why Cloudino & Benefit Section (100% Full Width) */}
    <WhyCloudinoCareer client:load />

    {/* Open Positions Section */}
    <section class="bg-black py-12 sm:py-20 px-4 sm:px-6">
      <div class="w-full max-w-7xl mx-auto text-center">
        <h2
          class="text-3xl sm:text-5xl lg:text-6xl font-bold text-white text-center tracking-tight"
        >
          Các vị trí đang tuyển dụng
        </h2>
        <p
          class="mt-3 sm:mt-4 mx-auto max-w-[680px] text-sm sm:text-base md:text-lg font-normal text-white/70 text-center leading-relaxed mb-8 sm:mb-12"
        >
          Click để xem chi tiết mô tả công việc và nộp hồ sơ ứng tuyển.
        </p>
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 text-left"
        >
          {
            positions.map((item) => (
              <div class="group rounded-2xl border border-accent bg-accent/40 p-6 sm:p-8 flex flex-col justify-between hover:border-white/50 transition-all duration-300 shadow-lg">
                <div>
                  <h3 class="text-xl sm:text-2xl font-semibold text-white group-hover:text-purple-200 transition-colors">
                    {item.title}
                  </h3>
                  <p class="mt-3 text-sm sm:text-base text-white/70">
                    <strong class="text-white font-medium">Location: </strong>
                    {item.location}
                  </p>
                  <p class="mt-1 text-sm sm:text-base text-white/70">
                    <strong class="text-white font-medium">Lương: </strong>
                    {item.salary}
                  </p>
                </div>
                <div>
                  <a
                    class="px-6 py-3 rounded-full bg-accent/40 border border-accent mt-6 hover:bg-white hover:text-black z-10 inline-block text-xs sm:text-sm font-semibold text-white tracking-wider transition-all duration-200 cursor-pointer shadow-sm hover:shadow-md"
                    href={`/career/${item.link}`}
                  >
                    Xem chi tiết →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
