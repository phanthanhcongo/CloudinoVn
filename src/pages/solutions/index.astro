---
import Layout from "../../layouts/Layout.astro";
import SolutionsTabs from "../../components/SolutionsTabs";
import PurpleOrb from "../../components/PurpleOrb";
---

<Layout title="Solutions | Cloudino">
  {/* Hero */}
  <section
    class="relative flex h-[480px] sm:h-[750px] md:h-[930px] items-center overflow-hidden bg-black"
  >
    <img
      src="/images/backgrounds/Data&AI.gif"
      alt=""
      class="absolute inset-0 h-full w-full object-cover mix-blend-screen opacity-35 sm:opacity-70 filter brightness-90 sm:brightness-125 pointer-events-none"
    />

    {/* Vibrant Purple Glow Orb centered in Hero */}
    <PurpleOrb size={320} blur={100} opacity={0.6} className="sm:hidden" />
    <PurpleOrb size={650} blur={130} opacity={0.65} className="hidden sm:block" />

    {/* Concentric rotating dashed circle - Centered on Mobile & Desktop */}
    <div
      class="animate-spin-slow absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[320px] w-[320px] sm:h-[600px] sm:w-[600px] md:h-[932px] md:w-[932px] rounded-full pointer-events-none z-0"
    >
      <svg class="h-full w-full" viewBox="0 0 932 932">
        <circle
          cx="466"
          cy="466"
          r="465"
          fill="none"
          stroke="rgba(255, 255, 255, 0.4)"
          stroke-width="1.5"
          stroke-dasharray="12 10"
        />
      </svg>
    </div>

    {/* 3D Graphic - Hidden on Mobile */}
    <img
      src="/images/hero/hero-graphic.png"
      alt=""
      class="animate-float absolute left-1/2 top-1/2 hidden md:block ml-40 lg:ml-80 h-[400px] w-[400px] lg:h-[660px] lg:w-[660px] mt-40 lg:mt-80 -translate-y-1/2 object-contain opacity-100 z-10 pointer-events-none"
    />

    <div
      class="relative z-20 mx-auto w-full max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px] text-center"
    >
      <h1
        class="text-5xl sm:text-7xl md:text-9xl xl:text-[140px] font-extrabold text-transparent bg-clip-text tracking-tight uppercase"
        style="background-image: linear-gradient(90deg, #9bb0d8 0%, #cbd2b8 15%, #ece289 35%, #d4cb7b 50%, #ea98b9 70%, #e877c8 88%, #dd65d8 100%); -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.85);"
      >
        Solutions
      </h1>
    </div>
  </section>

  <SolutionsTabs client:load />
</Layout>
