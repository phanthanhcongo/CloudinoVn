---
import Stats from "../../../components/Stats";
import Layout from "../../../layouts/Layout.astro";

export function getStaticPaths() {
  return [{ params: { service: "ai-data" } }];
}

const cases = [
  {
    title:
      "[ViMeeting+] Ứng dụng tự động hóa quy trình phiên âm và tóm tắt cuộc họp đa ngôn ngữ",
    subtext:
      "Làm chủ dữ liệu cuộc họp: Tự động hoá phiên âm và tóm tắt cuộc họp với Generative AI trên AWS",
    image: "/images/backgrounds/ViMeeting+.jpg",
  },
  {
    title:
      "MaxcomGroup – Chatbot AI Nâng Tầm Trải Nghiệm Khách Hàng Cho AIGENX",
    subtext:
      "Tìm hiểu cách AIGENX tận dụng AWS GenAI để cải thiện tương tác khách hàng, nâng cao độ chính xác phản hồi và mở rộng quy mô linh hoạt mà vẫn đảm bảo bảo mật hàng đầu.",
    image: "/images/backgrounds/MaxcomGroup.jpg",
  },
  {
    title:
      "Masan - Bứt Phá Tăng Trưởng, Tiết Kiệm Chi Phí với Hành Trình Chuyển Đổi Lên Đám Mây AWS",
    subtext:
      "Masan, một trong những công ty hàng tiêu dùng hàng đầu Việt Nam, đã đối mặt với nhiều thách thức về hạ tầng tại chỗ, bao gồm khả năng mở rộng hạn chế, chi phí cao và sự thiếu linh hoạt. Để giải quyết những vấn đề này, Masan đã hợp tác với Cloudino, đối tác tư vấn AWS hàng đầu tại Việt Nam, để chuyển đổi hệ thống của mình lên đám mây AWS.",
    image: "/images/backgrounds/Masan.jpg",
  },
];

const stats = [
  { value: "1000+", label: "Cloud-based AI/ML and data projects delivery" },
  { value: "200K+", label: "Clients served in AI & Data projects" },
  { value: "99+", label: "Specialized AI & Data engineers" },
];
---

<Layout title="AI & Data | Cloudino">
  <main class="bg-black">
    {/* Hero */}
    <section
      class="relative flex h-[930px] items-center overflow-hidden bg-black"
    >
      <img
        src="/images/backgrounds/AICC.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-30 mix-blend-lighten"
      />
      <img
        src="/images/backgrounds/M&M.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20 mix-blend-lighten"
      />
      <div
        class="relative mx-auto w-full max-w-[1920px] px-[285px] text-center"
      >
        <div class="mx-auto max-w-[1519px]">
          <h1
            class="text-[128px] font-bold leading-none text-transparent bg-clip-text"
            style="background-image:linear-gradient(45deg,#5B6FF5,#D4CB7B 52.6%,#DA3FF0)"
          >
            AI & Data
          </h1>
          <p
            class="mt-6 mx-auto max-w-[740px] text-base font-normal text-white"
          >
            Giúp doanh nghiệp phân tích bài toán theo từng ngành và đánh giá
            toàn diện sự sẵn sàng của dữ liệu, hạ tầng.
          </p>
          <a
            href="/contact"
            class="mt-8 mx-auto inline-flex h-[60px] w-[201px] items-center justify-center rounded-full border border-white/20 text-xl font-normal tracking-[-1px] text-white backdrop-blur-md transition-all hover:bg-white hover:text-black"
            style="background:rgba(255,255,255,0.05)"
          >
            CONTACT US →
          </a>
        </div>
      </div>
    </section>

    {/* Tab navigation */}
    <section
      class="sticky top-[101px] z-30 bg-black/90 backdrop-blur-xl border-b border-white/10"
    >
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="flex gap-0 justify-center">
          {
            [
              "Story",
              "Overview",
              "Framework",
              "Awards",
              "Case Stories",
              "Insight",
              "FAQ",
            ].map(tab => (
              <a
                href={`#${tab.toLowerCase().replace(/\s+/g, "-")}`}
                class="px-6 py-4 text-2xl font-normal text-white/70 transition-colors hover:text-white border-b-2 border-transparent hover:border-accent"
              >
                {tab}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* Stats */}
    <section class="bg-black py-16">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <Stats stats={stats} />

        <div class="mt-12 flex flex-col items-center gap-8">
          <h3 class="text-5xl font-light text-white max-w-[900px] text-center">
            Đối tác được tin chọn bởi hơn 80% doanh nghiệp lớn trong nước
          </h3>
          <p
            class="text-base font-normal text-white/70 max-w-[406px] text-center"
          >
            Khẳng định giá trị kinh doanh đột phá dựa trên những dự án thành
            công thực tiễn cùng nền tảng dữ liệu quy mô lớn.
          </p>
        </div>

        <div
          class="mt-8 flex justify-between"
          style="marginLeft:'-60px',marginRight:'-60px'"
        >
          {
            Array.from({ length: 8 }, (_, i) => (
              <div class="flex h-36 w-110 items-center justify-center">
                <img
                  src={`/images/logos-cleaned/${i + 1}.png`}
                  alt=""
                  class="max-h-full max-w-full object-fit"
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Customer Success Story */}
    <section class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="flex gap-10">
          <div class="flex-1 max-w-[870px]">
            <p class="text-base font-normal text-white/70">
              Customer Success Story Global Airline
            </p>
            <h2 class="mt-2 text-5xl font-light text-white">
              Proactively identify hidden attack paths and tangible risks
              through CNAPP-based integrated security governance
            </h2>
            <p class="mt-4 text-base font-normal text-white/70 max-w-[548px]">
              By connecting dispersed cloud security information into one
              unified view, you can identify security blind spots and attack
              paths across multi-cloud environments at a glance.
            </p>
          </div>
          <img
            src="/images/hero/hero-graphic.png"
            alt=""
            class="h-[480px] w-[480px] shrink-0 object-contain opacity-60"
          />
        </div>
      </div>
    </section>

    {/* Explore Solutions */}
    <section id="story" class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">Explore Solutions</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-3 gap-10">
          {
            Array.from({ length: 3 }, (_, i) => (
              <div
                class="w-[480px] rounded-2xl border border-white/10 p-8 backdrop-blur-sm"
                style="background:rgba(255,255,255,0.02)"
              >
                <img
                  src={`/images/backgrounds/deco-${i + 1}.png`}
                  alt=""
                  class="h-[235px] w-[418px] rounded-lg object-cover"
                />
                <h3 class="mt-4 text-2xl font-normal text-white">
                  lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                  diam nonummy nibh euismod
                </h3>
                <p class="mt-2 text-base font-normal text-white/60">
                  lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                  diam nonummy nibh euismod tincidunt ut lorem ipsum dolor sit
                  amet consectetuer adipiscing elit sed diam nonummy nibh
                  euismod tincidunt ut
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Framework */}
    <section id="framework" class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">Framework</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-3 gap-10">
          {
            ["01", "02", "03"].map((num, i) => (
              <div
                class="w-[480px] rounded-2xl border border-white/10 p-8 backdrop-blur-sm"
                style="background:rgba(255,255,255,0.02)"
              >
                <div
                  class="flex h-[100px] w-[100px] items-center justify-center rounded-full border border-white/10"
                  style="background:rgba(49,46,129,0.2)"
                >
                  <span class="text-4xl font-normal text-white">{num}</span>
                </div>
                <h3 class="mt-6 text-2xl font-normal text-white">
                  lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                  diam nonummy nibh euismod
                </h3>
                <p class="mt-2 text-base font-normal text-white/60">
                  lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                  diam nonummy nibh euismod tincidunt ut
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Awards */}
    <section id="awards" class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">Awards</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-2 gap-10">
          {
            Array.from({ length: 2 }, (_, i) => (
              <div
                class="flex gap-8 rounded-2xl border border-white/10 p-8 backdrop-blur-sm"
                style="background:rgba(255,255,255,0.02)"
              >
                <img
                  src={`/images/backgrounds/deco-${i + 1}.png`}
                  alt=""
                  class="h-[190px] w-[285px] shrink-0 rounded-lg object-cover"
                />
                <div>
                  <h3 class="text-2xl font-normal text-white">
                    lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                    diam nonummy nibh euismod
                  </h3>
                  <p class="mt-2 text-base font-normal text-white/60">
                    lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                    diam nonummy nibh euismod tincidunt ut
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Case Stories */}
    <section id="case-stories" class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">Case Stories</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-3 gap-10">
          {
            cases.map((item, i) => (
              <a
                href={`/success-stories/${i + 1}`}
                class="group bg-accent/40 p-4 rounded-4xl"
              >
                <div class="h-[440px] overflow-hidden rounded-lg">
                  <img
                    src={item.image}
                    alt=""
                    class="h-full w-full object-cover"
                  />
                </div>
                <h3 class="mt-4 text-2xl font-bold text-white group-hover:text-primary">
                  {item.title}
                </h3>
                <p class="mt-2 text-base font-normal text-white">
                  {item.subtext}
                </p>
                <div
                  class="mt-6 flex h-[48px] sm:h-[60px] w-[170px] sm:w-[194px] items-center justify-center rounded-full border border-purple-400/50 text-base sm:text-xl font-medium tracking-[-0.5px] text-white backdrop-blur-xl bg-gradient-to-r from-[#312e81] via-[#5b3db5] to-[#7d51d3] hover:bg-white hover:text-[#201048] shadow-[0_0_25px_rgba(168,85,247,0.45)] hover:shadow-[0_0_35px_rgba(168,85,247,0.75)] hover:scale-105 transition-all duration-300"
                >
                  LEARN MORE →
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* Insights */}
    <section id="insight" class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">Insights</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-4 gap-10">
          {
            Array.from({ length: 4 }, (_, i) => (
              <a href="/resources" class="group w-[350px]">
                <p class="text-base font-normal text-white/50">26/07/2026</p>
                <div class="mt-4 h-[200px] w-[288px] overflow-hidden rounded-lg">
                  <img
                    src={`/images/backgrounds/deco-${i + 1}.png`}
                    alt=""
                    class="h-full w-full object-cover"
                  />
                </div>
                <h3 class="mt-4 max-w-[288px] text-xl font-normal text-white group-hover:text-primary">
                  lorem ipsum dolor sit amet consecte adipiscing elit sed...
                </h3>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section id="faq" class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">FAQ</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
        <div class="space-y-4 max-w-[1520px]">
          {
            Array.from({ length: 8 }, (_, i) => (
              <details
                class="group rounded-2xl border border-white/10 backdrop-blur-sm"
                style="background:rgba(255,255,255,0.02)"
              >
                <summary class="flex cursor-pointer items-center justify-between px-8 py-6 text-base font-normal text-white">
                  lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                  diam nonummy nibh euismod tincidunt ut
                  <svg
                    class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="1.5"
                  >
                    <path d="M5 7.5L10 12.5L15 7.5" />
                  </svg>
                </summary>
                <div class="px-8 pb-6 text-base font-normal text-white/60">
                  {i === 1 ? (
                    <p>
                      lorem ipsum dolor sit amet consectetuer adipiscing elit
                      sed diam nonummy nibh euismod tincidunt ut lorem ipsum
                      dolor sit amet consectetuer adipiscing elit sed diam
                      nonummy nibh euismod tincidunt ut lorem ipsum dolor sit
                      amet consectetuer adipiscing elit sed diam nonummy nibh
                      euismod tincidunt ut
                    </p>
                  ) : (
                    <p>
                      Bộ nhận diện thương hiệu là hệ thống các yếu tố hình ảnh
                      và ứng dụng thể hiện thương hiệu trên mọi điểm chạm. Mỗi
                      dự án tại Sao Kim đều trải qua 5 giai đoạn chuẩn: Nghiên
                      cứu, Chiến lược, Thiết kế concept, Hiện thực hóa và Bàn
                      giao.
                    </p>
                  )}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
