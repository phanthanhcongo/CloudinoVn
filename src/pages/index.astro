---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero";
import ServiceCards from "../components/ServiceCards";
import PartnerLogos from "../components/PartnerLogos";
import StatsGrid from "../components/StatsGrid";
import GoalOptions from "../components/GoalOptions";
import SolutionGrid from "../components/SolutionGrid";
import IndustryGrid from "../components/IndustryGrid";
import SuccessStories from "../components/SuccessStories";
import TestimonialCarousel from "../components/TestimonialCarousel";
import ResourceCards from "../components/ResourceCards";
import SectionHeader from "../components/SectionHeader";
import CertificationsGrid from "../components/CertificationsGrid";
---

<Layout
  title="Cloudino - Powering Business Beyond the Cloud"
  description="Cloudino is a cloud solutions provider powering business beyond the cloud with AWS, DigitalOcean, and Lark."
>
  <main class="tracking-tighter">
    <Hero client:load />
    <div class="-mt-[100px] sm:-mt-[160px] md:-mt-[280px] lg:-mt-107.25">
      <ServiceCards client:load />
    </div>
    <PartnerLogos client:load />
    <StatsGrid client:load />
    <GoalOptions client:load />
    <SolutionGrid client:load />
    <IndustryGrid client:load />
    <SuccessStories client:load />
    <TestimonialCarousel client:load />
    <!-- <ResourceCards client:load /> -->

    <section
      id="certifications-section"
      class="scroll-mt-28 relative bg-black py-10 sm:py-14 md:py-16"
    >
      <div
        class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px] text-center"
      >
        <SectionHeader title="Certification" leftPercent={0} />
        <h2 class="text-xl sm:text-3xl md:text-4xl font-light text-white">
          Global Partnerships and Certifications
        </h2>
        <p class="mt-2 mb-6 text-xs sm:text-sm font-normal text-white/70">
          We possess globally recognized technical expertise and service
          quality.
        </p>

        <CertificationsGrid client:load />
      </div>
    </section>
  </main>
</Layout>
