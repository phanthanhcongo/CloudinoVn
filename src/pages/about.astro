---
import Layout from "../layouts/Layout.astro";
import Stats from "../components/Stats";
import TestimonialCarousel from "../components/TestimonialCarousel";

const stats = [
  {
    value: "1000+",
    label: "Khách hàng doanh nghiệp",
  },
  {
    value: "99+",
    label: "Nhân sự",
  },
  {
    value: "5",
    label: "Văn phòng toàn cầu",
  },
  {
    value: "10",
    label: "Năm kinh nghiệm",
  },
];

const whyCloudino = [
  "Đội ngũ kỹ sư đạt chứng chỉ với chuyên môn sâu rộng về các nền tảng AWS, DigitalOcean và Lark Suite",
  "Thiết kế và tối ưu hạ tầng linh hoạt theo đúng bài toán và quy mô của từng tổ chức.",
  "Lên chiến lược phân bổ tài nguyên thông minh (Cloud Cost Optimization) giúp tiết kiệm ngân sách.",
  "Cung cấp hạ tầng đạt các tiêu chuẩn an toàn dữ liệu",
];
---

<Layout title="About us | Cloudino">
  <main class="bg-black">
    {/* Hero */}
    <section
      class="relative flex h-[930px] items-center overflow-hidden bg-[#080808] border-b border-accent"
    >
      <img
        src="/images/backgrounds/image119.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover mix-blend-lighten"
      />
      <div class="absolute inset-0 flex">
        <img
          src="/images/backgrounds/0h37rd5uqew61.gif"
          alt=""
          class="h-full w-1/2 object-cover -rotate-90 mix-blend-lighten"
        />
        <img
          src="/images/backgrounds/0h37rd5uqew61.gif"
          alt=""
          class="h-full w-1/2 object-cover -rotate-90 mix-blend-lighten"
        />
      </div>
      <div
        class="relative mx-auto w-full max-w-[1920px] px-[285px] text-center"
      >
        <div class="mx-auto max-w-[740px]">
          <h1
            class="text-[96px] font-bold leading-none text-transparent bg-clip-text"
            style="background-image:linear-gradient(45deg,#5B6FF5,#D4CB7B 52.6%,#DA3FF0)"
          >
            About us
          </h1>
          <p class="mt-0 text-2xl font-normal text-white">
            Cloudino là nhà cung cấp giải pháp đám mây thế hệ mới, mang đến các
            dịch vụ linh hoạt, tiết kiệm chi phí và dễ dàng tích hợp cho mọi quy
            mô doanh nghiệp. Chúng tôi hướng đến việc thúc đẩy chuyển đổi số, hỗ
            trợ doanh nghiệp ứng dụng AI, bảo vệ dữ liệu trọng yếu và xây dựng
            hạ tầng IT ổn định, bền vững ở quy mô lớn.
          </p>
        </div>
      </div>
    </section>

    {/* Cloudino Brand */}
    <section class="bg-black py-8 mx-auto -mt-20 z-10">
      <div class="mx-auto max-w-[1920px] px-[285px] flex justify-center">
        <div
          class="relative overflow-hidden text-5xl font-bold text-white text-center uppercase rounded-[48px] px-8 py-4 backdrop-blur-xl border border-accent/80 bg-accent/20"
        >
          {/* Liquid highlight */}
          <div
            class="absolute inset-0 rounded-4xl"
            style={{
              background:
                "linear-gradient(180deg, rgba(255,255,255,0.15) 0%, transparent 40%)",
            }}
          >
          </div>
          <span class="relative">Cloudino</span>
        </div>
      </div>
    </section>

    {/* Our Mission & Vision */}
    <section class="relative overflow-hidden bg-black py-24">
      <img
        src="/images/backgrounds/image119.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover mix-blend-lighten"
      />
      {/* Background decorations */}
      <div
        class="absolute -right-40 top-1/2 h-[761px] w-[761px] -translate-y-1/2 rounded-full border border-white/[0.04]"
      >
      </div>
      <img src="/images/backgrounds/about-bg-2.png" class="mx-auto my-36" />
      <img
        src="/images/hero/hero-graphic.png"
        alt=""
        class="absolute right-0 -bottom-96 h-[1075px] w-[1075px] object-contain opacity-80"
      />
      <div
        class="absolute right-[200px] top-[-100px] flex h-[420px] w-[420px] items-center justify-center rounded-2xl border border-white/[0.06] opacity-40"
      >
        <div class="h-[216px] w-[216px] rounded-full bg-white/5"></div>
      </div>
      {/* Big Cloudino text above content */}
      <div class="relative mb-12 flex w-full justify-between -ml-24 gap-12">
        {
          ["Cloudino", "Cloudino", "Cloudino", "Cloudino"].map((w, i) => (
            <span class="flex-1 text-center text-[150px] font-bold leading-none tracking-tighter text-accent/20">
              {w}
            </span>
          ))
        }
      </div>
      <div class="relative mx-auto max-w-[1920px] px-[285px]">
        <h2 class="text-5xl font-light text-white">Sứ mệnh và tầm nhìn</h2>
        <h3
          class="mt-4 text-[64px] font-bold leading-tight text-transparent bg-clip-text max-w-[876px] uppercase"
          style="background-image:linear-gradient(90deg,#312E81,#7D51D3)"
        >
          ĐỒNG HÀNH CHUYỂN ĐỔI, KIẾN TẠO TƯƠNG LAI
        </h3>
        <p class="mt-6 max-w-[740px] text-2xl font-normal text-white/80">
          Trở thành đối tác phân phối công nghệ đáng tin cậy, giúp doanh nghiệp
          trên toàn thế giới tiếp cận các giải pháp số linh hoạt, an toàn và dễ
          triển khai.
        </p>
        <p class="mt-4 max-w-[740px] text-2xl font-normal text-white/80">
          Mang các giải pháp đám mây đáng tin cậy trở nên dễ tiếp cận và đơn
          giản hơn, giúp doanh nghiệp tự tin thúc đẩy hành trình chuyển đổi số.
        </p>
      </div>
    </section>

    {/* A Journey of Innovation */}
    <section class="bg-accent/60 py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="flex items-start gap-20">
          <h3 class="text-5xl font-light text-white max-w-[613px]">
            Hành trình Đổi mới: Từ Điện toán Đám mây đến Trí tuệ Nhân tạo.
          </h3>
          <p class="max-w-[480px] text-2xl font-normal text-white/80">
            Kế thừa bề dày kinh nghiệm về công nghệ đám mây, Cloudino tự hào là
            đối tác đáng tin cậy, giúp khách hàng đón đầu xu hướng và tăng
            trưởng vượt bậc trong kỷ nguyên AI.
          </p>
        </div>
      </div>
      <div class="mx-auto max-w-[1920px] px-[285px] mt-24">
        <div
          class="relative flex justify-start gap-12 border-t border-white/20 pt-8"
        >
          {
            [
              {
                year: "2010",
                text: "CLOUDINO được vận hành bởi đội ngũ sở hữu chứng chỉ quốc tế cấp bởi Amazon Web Services, đảm bảo mang lại giải pháp điện toán đám mây tốt nhất cho khách hàng. Hỗ trợ doanh nghiệp xây dựng chiến lược, thiết kế kiến trúc, triển khai, tối ưu và quản lý hệ thống hạ tầng điện toán đám mây.",
              },
              {
                year: "2026",
                text: "Đánh dấu một bước tiến vượt bậc trong hành trình phát triển của CLOUDINO. Chúng tôi tự hào khẳng định vị thế là đối tác phân phối chính thức (Retail Partner) của 3 thương hiệu công nghệ hàng đầu toàn cầu, bao phủ toàn diện từ hạ tầng điện toán đám mây (IaaS) đến phần mềm dịch vụ (SaaS): AWS, DigitalOcean và Lark Suite. ",
              },
            ].map(item => (
              <div class="relative flex flex-col items-center">
                <p class="mt-2 text-2xl font-normal text-white">{item.year}</p>
                <p class="mt-4 max-w-[350px] text-base font-normal text-white">
                  {item.text}
                </p>
                <div class="absolute -top-4 flex h-7 w-7 items-center justify-center rounded-full border border-white/30 bg-black">
                  <div class="h-5 w-5 rounded-full bg-white" />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Why Cloudino */}
    <section class="relative overflow-hidden bg-black py-24 min-h-[1280px]">
      <img
        src="/images/backgrounds/image119.png"
        alt=""
        class="absolute inset-0 top-0 left-0 object-cover mix-blend-lighten"
      />
      <img
        src="/images/backgrounds/image 143.png"
        alt=""
        class="absolute bottom-0 object-cover"
      />
      <div
        class="absolute right-[200px] top-0 left-0 flex h-[420px] w-[420px] items-center justify-center rounded-2xl object-cover mix-blend-lighten"
      >
        <img
          src="/images/backgrounds/image 114.png"
          alt=""
          class="h-full w-full object-contain"
        />
      </div>
      <div class="relative mx-auto max-w-[1920px] px-[285px]">
        <h2 class="text-[96px] font-light text-white">Why Cloudino</h2>

        {/* Engineer cards */}
        <div class="mt-16 flex justify-between gap-10">
          {
            whyCloudino.map((item, i) => (
              <div class="w-[300px] rounded-2xl p-6 backdrop-blur-sm bg-accent/20 border-2 border-accent/80 flex flex-col items-center">
                <img
                  src="/images/icons/service-card.png"
                  alt=""
                  class="h-24 object-contain "
                />
                <p class="mt-6 max-w-[288px] text-base font-normal text-white/70">
                  {item}
                </p>
              </div>
            ))
          }
        </div>
        <!-- <div class="mt-16 flex justify-between gap-10">
          {
            Array.from({ length: 2 }, (_, i) => (
              <div class="w-[300px] rounded-2xl p-6 backdrop-blur-sm bg-accent/20 border-2 border-accent/80 flex flex-col items-center">
                <div class="flex h-[60px] w-[60px] items-center justify-center rounded-full bg-white/10" />
                <p class="mt-6 max-w-[288px] text-base font-normal text-white/70">
                  Certified engineers with deep expertise across AWS,
                  DigitalOcean, and Lark Suite.
                </p>
              </div>
            ))
          }
        </div> -->
      </div>
    </section>

    {/* Cloud In Numbers */}
    <section class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <h2 class="text-[96px] font-light text-white text-center">Thành tựu</h2>
        <div class="">
          <Stats stats={stats} />
        </div>
      </div>
    </section>

    {/* Client Testimonials */}
    <section>
      <TestimonialCarousel />
    </section>

    {/* Solutions Provided */}
    <section class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="grid grid-cols-2 gap-8">
          <h2
            class="text-[96px] font-light leading-tight text-white max-w-[480px]"
          >
            Các giải pháp từ CLOUDINO
          </h2>
          <div>
            <p class="text-2xl font-normal text-white/80">
              Từ việc ứng dụng và vận hành điện toán đám mây cho đến chuyển đổi
              thông minh tích hợp AI, CLOUDINO mang đến hệ sinh thái giải pháp
              toàn diện, đồng hành cùng hành trình chuyển đổi số của khách hàng
              đi đến thành công.
            </p>
            <div class="mt-16 grid grid-cols-2 gap-10">
              {
                [
                  {
                    title: "AI & Dữ liệu",
                    text: "Nâng tầm trí tuệ doanh nghiệp thông qua việc ra quyết định dựa trên dữ liệu và triển khai các mô hình AI",
                  },
                  {
                    title: "Bảo mật",
                    text: "Cung cấp hệ thống bảo mật cấp doanh nghiệp, từ thiết kế kiến trúc an toàn trên đám mây đến đáp ứng các tiêu chuẩn tuân thủ. ",
                  },
                  {
                    title: "Điện toán đám mây",
                    text: "Triển khai các dự án nền tảng Dữ liệu / Học máy (ML) / AI trên nền tảng đám mây.",
                  },
                  {
                    title: "Sản phẩm",
                    text: "Cung cấp các giải pháp phần mềm dạng dịch vụ (SaaS) nhằm tự động hóa quy trình làm việc, tối ưu hiệu suất cộng tác, nâng tầm trải nghiệm khách hàng và tối ưu hóa chi phí.",
                  },
                ].map(item => (
                  <div class="p-4">
                    <h3 class="text-4xl font-normal text-white">
                      {item.title}
                    </h3>
                    <p class="mt-2 text-base font-normal text-white/60">
                      {item.text}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Promise beyond Technology */}
    <section class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="flex gap-20">
          <div class="max-w-[629px]">
            <h2 class="text-5xl font-light text-white">
              Lời cam kết hơn cả một giải pháp công nghệ
            </h2>
            <p class="mt-6 text-base font-normal text-white/70">
              Trong kỷ nguyên của Đám mây và AI, dữ liệu khách hàng cùng hạ tầng
              CNTT là những tài sản quan trọng và nhạy cảm nhất. Cloudino tự hào
              là đối tác kỹ thuật số đáng tin cậy. Chúng tôi không chỉ cung cấp
              các lớp bảo mật kỹ thuật thông thường mà còn cam kết bảo vệ an
              toàn tuyệt đối tài sản của khách hàng bằng ý thức đạo đức nghề
              nghiệp khắt khe nhất.
              <p class="mt-4 text-base font-normal text-white/70">
                Tại Cloudino, "Đạo đức" luôn được đặt làm tôn chỉ ưu tiên hàng
                đầu trong mọi hoạt động quản trị và vận hành.
              </p>
            </p>
          </div>
          <img
            src="/images/backgrounds/image 146.png"
            alt=""
            class="w-150 h-auto rounded-lg object-cover"
          />
        </div>
      </div>

      {/* Global Network */}
      <section class="relative bg-black py-24 min-h-[600px] flex items-center">
        <img
          src="/images/backgrounds/about-bg-3.png"
          alt=""
          class="absolute inset-0 h-full w-full object-cover mix-blend-lighten"
        />
        <div class="relative mx-auto max-w-[1920px] px-[285px]">
          <h2 class="text-5xl font-light text-white text-center">
            Nhằm đáp ứng nhu cầu kinh doanh toàn cầu, Cloudino vận hành mạng
            lưới kết nối trực tiếp trải rộng khắp các khu vực.
          </h2>
        </div>
      </section>
    </section>

    {/* Leadership team */}
    <section class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <h2 class="text-[96px] font-light text-white text-center">
          Đội ngũ lãnh đạo
        </h2>
        <div class="mt-16 flex justify-around gap-10">
          {
            [
              {
                image: "/images/CTO.png",
                name: "Trần Đại Đồng",
                role: "Chief Technology Officer",
              },
              {
                image: "/images/CEO.png",
                name: "Hồ Việt Anh",
                role: "Chief Executive Officer",
              },
            ].map((item, i) => (
              <div class="w-[350px] border-2 border-accent rounded-4xl bg-linear-to-r from-[#312E81] to-accent flex flex-col items-center p-2">
                <img src={item.image} class="w-full h-auto" />
                <div>{item.name}</div>
                <div>{item.role}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Careers CTA */}
    <section class="relative bg-black py-32">
      <img
        src="/images/backgrounds/image119.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover mix-blend-lighten"
      />
      <div
        class="relative mx-auto max-w-[1920px] px-[285px] flex flex-col items-center"
      >
        <h2 class="text-[96px] font-light text-white">Cơ hội nghề nghiệp</h2>
        <p class="mt-8 text-base font-normal text-white/70">
          Nơi hội tụ của sự Đổi mới và Tinh thần hợp tác
        </p>
        <h3 class="mt-4 text-5xl font-light text-white">
          Chúng tôi đang tuyển dụng
        </h3>
        <p class="mt-2 text-base font-normal text-white/70">
          Cùng tài năng của bạn kiến tạo tương lai doanh nghiệp.
        </p>
        <a
          href="/career"
          class="mt-8 inline-flex h-[60px] w-[266px] items-center justify-center rounded-full border border-white/20 text-xl font-normal tracking-[-1px] text-white backdrop-blur-md transition-all hover:bg-white hover:text-accent bg-accent"
        >
          Tìm kiếm cơ hội →
        </a>
      </div>
    </section>

    {/* Contact Form */}
    <!-- <section class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="flex gap-20">
          <div
            class="w-[740px] rounded-2xl border border-white/10 p-10 backdrop-blur-sm"
            style="background:rgba(255,255,255,0.02)"
          >
            <h3 class="text-2xl font-normal text-white">Contact us</h3>
            <div class="mt-8 space-y-4">
              <div
                class="rounded-lg border border-white/10 px-4 py-5 text-base font-normal text-white/40"
                style="background:rgba(255,255,255,0.02)"
              >
                Full name
              </div>
              <div
                class="rounded-lg border border-white/10 px-4 py-5 text-base font-normal text-white/40"
                style="background:rgba(255,255,255,0.02)"
              >
                Email
              </div>
              <div
                class="rounded-lg border border-white/10 px-4 py-5 text-base font-normal text-white/40"
                style="background:rgba(255,255,255,0.02)"
              >
                Phone
              </div>
            </div>
            <p class="mt-6 text-base font-normal text-white/50">
              Please leave your information so we can advise you
            </p>
            <button
              class="mt-6 flex h-[60px] w-[201px] items-center justify-center rounded-full border border-white/20 text-xl font-normal tracking-[-1px] text-white backdrop-blur-md transition-all hover:bg-white hover:text-black"
              style="background:rgba(255,255,255,0.05)"
            >
              CONTACT US →
            </button>
          </div>
          <img
            src="/images/hero/hero-graphic.png"
            alt=""
            class="h-[650px] w-[858px] rounded-lg object-cover opacity-40"
          />
        </div>
      </div>
    </section> -->
  </main>
</Layout>
