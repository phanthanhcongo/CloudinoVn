---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Resources | Cloudino">
  <main class="pt-[101px] bg-black">
    <section class="py-[137px]">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <h1 class="text-[96px] font-light text-white">Resources</h1>
        <div class="mt-12 flex gap-4">
          {["All", "Blog", "Press Release", "New"].map((tag) => (
            <button class="rounded-full border border-white/20 px-6 py-2 text-base text-white/70 hover:border-primary hover:text-white">
              {tag}
            </button>
          ))}
        </div>
        <div class="mt-16 grid gap-8 md:grid-cols-3">
          {Array.from({ length: 9 }, (_, i) => (
            <a href={`/resources/${i + 1}`} class="group rounded-xl border border-white/10 p-6 transition-colors hover:border-primary/40">
              <div class="aspect-video rounded-lg bg-white/5" />
              <h3 class="mt-4 text-[40px] font-normal leading-tight text-white group-hover:text-primary">
                Lorem ipsum dolor sit amet
              </h3>
              <span class="mt-3 inline-block text-xl text-accent group-hover:underline">
                Press Release &rarr;
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
