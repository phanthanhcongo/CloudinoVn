---
import Stats from "../../../components/Stats";
import Layout from "../../../layouts/Layout.astro";
import SectionHeader from "../../../components/SectionHeader";

export function getStaticPaths() {
  return [{ params: { service: "ai-data" } }];
}

const cases = [
  {
    title:
      "[ViMeeting+] Ứng dụng tự động hóa quy trình phiên âm và tóm tắt cuộc họp đa ngôn ngữ",
    subtext:
      "Làm chủ dữ liệu cuộc họp: Tự động hoá phiên âm và tóm tắt cuộc họp với Generative AI trên AWS",
    image: "/images/backgrounds/ViMeeting+.jpg",
  },
  {
    title:
      "MaxcomGroup – Chatbot AI Nâng Tầm Trải Nghiệm Khách Hàng Cho AIGENX",
    subtext:
      "Tìm hiểu cách AIGENX tận dụng AWS GenAI để cải thiện tương tác khách hàng, nâng cao độ chính xác phản hồi và mở rộng quy mô linh hoạt mà vẫn đảm bảo bảo mật hàng đầu.",
    image: "/images/backgrounds/MaxcomGroup.jpg",
  },
  {
    title:
      "Masan - Bứt Phá Tăng Trưởng, Tiết Kiệm Chi Phí với Hành Trình Chuyển Đổi Lên Đám Mây AWS",
    subtext:
      "Masan, một trong những công ty hàng tiêu dùng hàng đầu Việt Nam, đã đối mặt với nhiều thách thức về hạ tầng tại chỗ, bao gồm khả năng mở rộng hạn chế, chi phí cao và sự thiếu linh hoạt. Để giải quyết những vấn đề này, Masan đã hợp tác với Cloudino, đối tác tư vấn AWS hàng đầu tại Việt Nam, để chuyển đổi hệ thống của mình lên đám mây AWS.",
    image: "/images/backgrounds/Masan.jpg",
  },
];

const stats = [
  { value: "1000+", label: "Cloud-based AI/ML and data projects delivery" },
  { value: "200K+", label: "Clients served in AI & Data projects" },
  { value: "99+", label: "Specialized AI & Data engineers" },
];

const exploreSolutions = [
  {
    title: "What – Chúng tôi làm gì?",
    desc: "Cung cấp các giải pháp AI toàn diện giúp doanh nghiệp ứng dụng trí tuệ nhân tạo vào vận hành, chăm sóc khách hàng, tự động hóa quy trình và phân tích dữ liệu. Từ AI Assistant, AI Agent đến các giải pháp AI tích hợp vào nền tảng Cloud và môi trường làm việc số.",
    image: "/images/backgrounds/deco-1.png",
  },
  {
    title: "Who – Chúng tôi phục vụ ai?",
    desc: "Dành cho doanh nghiệp ở mọi quy mô đang muốn ứng dụng AI để nâng cao năng suất, tối ưu vận hành, cải thiện trải nghiệm khách hàng và tạo lợi thế cạnh tranh, với yêu cầu cao về bảo mật, khả năng mở rộng và hiệu quả đầu tư.",
    image: "/images/backgrounds/deco-2.png",
  },
  {
    title: "How – Chúng tôi triển khai như thế nào?",
    desc: "Chúng tôi kết hợp AI, Cloud và các nền tảng doanh nghiệp để xây dựng giải pháp phù hợp với từng nhu cầu. Tận dụng hệ sinh thái công nghệ từ AWS, Google Cloud, DigitalOcean và LarkSuite, chúng tôi giúp doanh nghiệp từ tư vấn, triển khai, tích hợp đến vận hành và tối ưu các giải pháp AI một cách linh hoạt, an toàn và hiệu quả.",
    image: "/images/backgrounds/deco-3.png",
  },
];

const frameworkSteps = [
  {
    step: "01",
    title: "Khảo sát & Đánh giá hệ thống",
    desc: "Trao đổi sơ bộ để nắm bắt tình hình hiện tại, sau đó tổ chức các cuộc họp đánh giá chuyên sâu để xác định chính xác nhu cầu và hiện trạng hệ thống của doanh nghiệp.",
  },
  {
    step: "02",
    title: "Đề xuất giải pháp & Xử lý sự cố",
    desc: "Đội ngũ chuyên gia đưa ra phương án tối ưu (dựa trên 6 trụ cột đám mây) và trực tiếp triển khai các hành động khắc phục sự cố, hoàn thiện hệ thống.",
  },
  {
    step: "03",
    title: "Duy trì & Đánh giá định kỳ",
    desc: "Tiến hành đánh giá kiến trúc Well-Architected mỗi năm một lần nhằm đảm bảo hệ thống luôn vận hành ổn định, bảo mật và tối ưu chi phí dài hạn.",
  },
];

const awardsList = [
  {
    desc: "Vinh danh những đóng góp vượt trội trong việc tư vấn, thiết kế và triển khai các giải pháp hạ tầng điện toán đám mây & AI quy mô lớn cho doanh nghiệp.",
    image: "/images/cert/aws-advanced-consulting-partner-plaque.png",
  },
  {
    desc: "Khẳng định năng lực chuyên sâu trong việc xây dựng, tối ưu hóa hệ thống dữ liệu lớn và bảo mật theo chuẩn mực quốc tế khắt khe nhất.",
    image: "/images/cert/aws-certified-badges-honeycomb.png",
  },
];

const faqList = [
  {
    question: "Doanh nghiệp nên bắt đầu hành trình chuyển đổi Cloud từ đâu?",
    answer:
      "Doanh nghiệp nên bắt đầu bằng việc đánh giá hệ thống hiện tại, xác định mục tiêu kinh doanh, nhu cầu về hiệu suất, bảo mật và chi phí. Từ đó xây dựng Cloud Roadmap phù hợp thay vì chuyển toàn bộ hệ thống lên Cloud cùng lúc.",
  },
  {
    question: "Có cần chuyển toàn bộ hệ thống lên Cloud không?",
    answer:
      "Không nhất thiết. Tùy vào đặc thù hệ thống và yêu cầu vận hành, doanh nghiệp có thể lựa chọn Public Cloud, Private Cloud, Hybrid Cloud hoặc mô hình kết hợp. Một số workload có thể tiếp tục vận hành On-premises trong khi các hệ thống phù hợp được chuyển lên Cloud.",
  },
  {
    question: "Làm thế nào để kiểm soát và tối ưu chi phí Cloud?",
    answer:
      "Doanh nghiệp cần theo dõi mức sử dụng tài nguyên, loại bỏ tài nguyên dư thừa, lựa chọn cấu hình phù hợp và thiết lập cơ chế quản trị chi phí. Áp dụng FinOps cũng giúp các nhóm kỹ thuật và kinh doanh kiểm soát chi phí Cloud hiệu quả hơn.",
  },
  {
    question: "Chuyển hệ thống lên Cloud có ảnh hưởng đến hoạt động hiện tại không?",
    answer:
      "Nếu có kế hoạch migration phù hợp, quá trình chuyển đổi có thể được triển khai theo từng giai đoạn để hạn chế tối đa gián đoạn. Việc kiểm thử, sao lưu dữ liệu và xây dựng phương án rollback là những bước quan trọng trước khi chuyển đổi chính thức.",
  },
  {
    question: "Cloudino hỗ trợ doanh nghiệp trong những giai đoạn nào?",
    answer:
      "Cloudino có thể đồng hành từ đánh giá hệ thống, tư vấn kiến trúc, xây dựng Cloud Roadmap đến migration, triển khai, tối ưu chi phí và vận hành hệ thống Cloud sau triển khai.",
  },
];
---

<Layout title="AI & Data | Cloudino">
  <main class="bg-black">
    {/* Hero */}
    <section
      class="relative flex min-h-[550px] h-auto py-16 sm:py-24 lg:min-h-[850px] items-center overflow-hidden bg-black"
    >
      <img
        src="/images/backgrounds/AICC.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20 sm:opacity-50 mix-blend-screen filter brightness-90 sm:brightness-125 pointer-events-none"
      />
      <img
        src="/images/backgrounds/M&M.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-15 sm:opacity-40 mix-blend-screen filter brightness-90 sm:brightness-125 pointer-events-none"
      />
      {/* Light black overlay layer */}
      <div class="absolute inset-0 bg-black/20 pointer-events-none z-0"></div>
      <div
        class="relative z-10 mx-auto w-full max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px] text-center"
      >
        <div class="mx-auto max-w-[1519px]">
          <h1
            class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl 2xl:text-[110px] font-extrabold leading-none text-transparent bg-clip-text tracking-tight uppercase"
            style="background-image: linear-gradient(90deg, #9bb0d8 0%, #cbd2b8 15%, #ece289 35%, #d4cb7b 50%, #ea98b9 70%, #e877c8 88%, #dd65d8 100%); -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.85);"
          >
            AI & Data
          </h1>
          <p
            class="mt-4 mx-auto max-w-[680px] text-xs sm:text-sm md:text-base lg:text-lg font-normal text-white/90 leading-relaxed"
          >
            Giúp doanh nghiệp phân tích bài toán theo từng ngành và đánh giá
            toàn diện sự sẵn sàng của dữ liệu, hạ tầng.
          </p>
          <a
            href="/contact"
            class="mt-6 mx-auto inline-flex h-[42px] sm:h-[50px] px-6 sm:px-8 items-center justify-center rounded-full border border-purple-400/30 text-sm sm:text-base font-medium tracking-wide text-white backdrop-blur-md transition-all hover:bg-white hover:text-black shadow-[0_0_20px_rgba(168,85,247,0.3)]"
            style="background:rgba(255,255,255,0.05)"
          >
            LIÊN HỆ NGAY →
          </a>
        </div>
      </div>
    </section>

    {/* Tab navigation */}
    <section
      class="sticky top-[56px] md:top-[70px] z-30 bg-black/90 backdrop-blur-xl border-b border-white/10"
    >
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <div
          class="flex overflow-x-auto scrollbar-none gap-2 sm:gap-4 md:gap-6 justify-start md:justify-center py-2 sm:py-0"
        >
          {
            [
              { label: "Giải pháp", href: "#story" },
              { label: "Khung triển khai", href: "#framework" },
              { label: "Giải thưởng", href: "#awards" },
              { label: "Câu chuyện thành công", href: "#case-stories" },
              { label: "Góc nhìn chuyên gia", href: "#insight" },
              { label: "Hỏi đáp", href: "#faq" },
            ].map((tab) => (
              <a
                href={tab.href}
                class="px-3 sm:px-4 py-2.5 sm:py-3.5 text-xs sm:text-sm lg:text-base font-normal text-white/70 whitespace-nowrap transition-colors hover:text-white border-b-2 border-transparent hover:border-purple-400"
              >
                {tab.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* Stats */}
    <section class="bg-black py-12 sm:py-16">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <Stats stats={stats} />

        <div class="mt-8 sm:mt-12 flex flex-col items-center gap-3 sm:gap-6">
          <h3
            class="text-lg sm:text-2xl lg:text-3xl font-light text-white max-w-[800px] text-center"
          >
            Đối tác được tin chọn bởi hơn 80% doanh nghiệp lớn trong nước
          </h3>
          <p
            class="text-xs sm:text-sm font-normal text-white/70 max-w-[406px] text-center"
          >
            Khẳng định giá trị kinh doanh đột phá dựa trên những dự án thành
            công thực tiễn cùng nền tảng dữ liệu quy mô lớn.
          </p>
        </div>

        <div
          class="mt-8 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4 items-center"
        >
          {
            Array.from({ length: 8 }, (_, i) => (
              <div class="flex h-24 sm:h-36 w-full items-center justify-center p-2">
                <img
                  src={`/images/logos-cleaned/${i + 1}.png`}
                  alt=""
                  class="max-h-full max-w-full object-contain filter brightness-90 hover:brightness-100 transition-all"
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Customer Success Story */}
    <section class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <div
          class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-center justify-between"
        >
          <div class="flex-1 max-w-[870px]">
            <p
              class="text-xs sm:text-sm font-normal text-purple-400 uppercase tracking-wider"
            >
              Khách hàng tiêu biểu: Hãng hàng không Quốc tế
            </p>
            <h2
              class="mt-2 text-lg sm:text-2xl lg:text-3xl font-light text-white leading-tight"
            >
              Ngăn chặn sớm các lỗ hổng bảo mật ẩn và rủi ro thực tế với Giải
              pháp quản trị an ninh tích hợp CNAPP
            </h2>
            <p
              class="mt-3 text-xs sm:text-sm font-normal text-white/70 max-w-[548px] leading-relaxed"
            >
              Quản lý tập trung mọi dữ liệu bảo mật rải rác trên một nền tảng
              duy nhất, giúp doanh nghiệp dễ dàng kiểm soát các "điểm mù" an
              ninh và rủi ro tấn công trên toàn bộ môi trường đa đám mây
              (multi-cloud).
            </p>
          </div>
          <img
            src="/images/hero/hero-graphic.png"
            alt=""
            class="h-[280px] w-[280px] sm:h-[380px] sm:w-[380px] lg:h-[480px] lg:w-[480px] shrink-0 object-contain opacity-70"
          />
        </div>
      </div>
    </section>

    {/* Explore Solutions */}
    <section id="story" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <SectionHeader title="Khám phá Giải pháp" leftPercent={0} client:load />
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-10"
        >
          {
            exploreSolutions.map((item) => (
              <div
                class="w-full rounded-2xl border border-white/10 p-6 sm:p-8 backdrop-blur-sm flex flex-col justify-between hover:border-purple-400/50 transition-all duration-300"
                style="background:rgba(255,255,255,0.02)"
              >
                <div>
                  <img
                    src={item.image}
                    alt={item.title}
                    class="h-[180px] sm:h-[235px] w-full rounded-lg object-cover"
                  />
                  <h3 class="mt-4 text-base sm:text-lg lg:text-xl font-bold text-white leading-snug">
                    {item.title}
                  </h3>
                  <p class="mt-2.5 text-xs sm:text-sm font-normal text-white/70 leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Framework */}
    <section
      id="framework"
      class="bg-black py-12 sm:py-20 lg:py-24 relative overflow-hidden"
    >
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <SectionHeader
          title="Quy trình triển khai"
          leftPercent={0}
          client:load
        />

        {/* Card Grid Container with Dotted Connecting Line */}
        <div class="relative">
          {/* Dotted connecting line in background */}
          <div
            class="hidden md:block absolute top-[60px] left-[15%] right-[15%] h-[2px] pointer-events-none z-0"
          >
            <svg class="w-full h-[60px] overflow-visible" fill="none">
              <path
                d="M 0 0 C 150 30, 250 -20, 400 10 C 550 40, 750 -10, 900 0"
                stroke="rgba(168, 85, 247, 0.4)"
                stroke-width="2"
                stroke-dasharray="6 6"></path>
            </svg>
          </div>

          <div
            class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8"
          >
            {
              frameworkSteps.map((item) => (
                <div
                  class="group flex flex-col items-center text-center rounded-[28px] border border-purple-500/30 p-8 sm:p-10 backdrop-blur-xl transition-all duration-300 hover:border-purple-400/70 hover:shadow-[0_0_35px_rgba(168,85,247,0.3)] hover:-translate-y-1.5"
                  style="background: linear-gradient(180deg, rgba(46, 18, 68, 0.65) 0%, rgba(20, 8, 32, 0.85) 100%);"
                >
                  {/* Purple Gradient Circle Badge */}
                  <div class="flex h-16 w-16 sm:h-20 sm:w-20 items-center justify-center rounded-full bg-gradient-to-b from-[#8b5cf6] to-[#5b21b6] text-xl sm:text-2xl font-medium text-white shadow-[0_0_20px_rgba(139,92,246,0.5)] border border-purple-300/30 shrink-0">
                    {item.step}
                  </div>

                  {/* Title */}
                  <h3 class="mt-6 text-base sm:text-lg lg:text-xl font-medium text-white leading-snug text-center">
                    {item.title}
                  </h3>

                  {/* Description */}
                  <p class="mt-3 text-xs sm:text-sm font-normal text-white/75 leading-relaxed text-center">
                    {item.desc}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* Awards */}
    <section id="awards" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <SectionHeader
          title="Giải thưởng & Chứng nhận"
          leftPercent={0}
          client:load
        />
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
          {
            awardsList.map((item) => (
              <div
                class="group flex flex-col items-center text-center rounded-[28px] border border-purple-500/30 p-8 sm:p-10 backdrop-blur-xl transition-all duration-300 hover:border-purple-400/70 hover:shadow-[0_0_35px_rgba(168,85,247,0.3)] hover:-translate-y-1.5"
                style="background: linear-gradient(180deg, rgba(46, 18, 68, 0.65) 0%, rgba(20, 8, 32, 0.85) 100%);"
              >
                {/* Center Award Image / Laurel Graphic */}
                <div class="my-4 sm:my-6 flex h-[150px] sm:h-[200px] w-full items-center justify-center">
                  <img
                    src={item.image}
                    alt=""
                    class="max-h-full max-w-[280px] sm:max-w-[340px] object-contain transition-transform duration-500 group-hover:scale-105"
                    style="filter: drop-shadow(0 0 25px rgba(168, 85, 247, 0.45));"
                  />
                </div>

                {/* Description */}
                <p class="text-xs sm:text-sm font-normal text-white/80 leading-relaxed text-center">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Case Stories */}
    <section id="case-stories" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <SectionHeader
          title="Câu chuyện thành công"
          leftPercent={0}
          client:load
        />
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-10"
        >
          {
            cases.map((item, i) => (
              <a
                href={`/success-stories/${i + 1}`}
                class="group bg-purple-950/30 border border-purple-500/20 p-4 sm:p-6 rounded-3xl transition-all duration-300 hover:border-purple-400/50 hover:bg-purple-900/40 flex flex-col justify-between"
              >
                <div>
                  <div class="h-[220px] sm:h-[300px] lg:h-[360px] overflow-hidden rounded-xl">
                    <img
                      src={item.image}
                      alt=""
                      class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                  <h3 class="mt-4 text-base sm:text-lg lg:text-xl font-bold text-white group-hover:text-purple-300 transition-colors">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-xs sm:text-sm font-normal text-white/80 line-clamp-3">
                    {item.subtext}
                  </p>
                </div>
                <div class="mt-5 flex h-[40px] sm:h-[46px] w-[140px] sm:w-[170px] items-center justify-center rounded-full border border-purple-400/50 text-xs sm:text-sm font-medium tracking-tight text-white backdrop-blur-xl bg-gradient-to-r from-[#312e81] via-[#5b3db5] to-[#7d51d3] hover:bg-white hover:text-[#201048] shadow-[0_0_20px_rgba(168,85,247,0.4)] hover:scale-105 transition-all duration-300">
                  XEM CHI TIẾT →
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* Insights */}
    <section id="insight" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <SectionHeader
          title="Góc nhìn chuyên gia"
          leftPercent={0}
          client:load
        />
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-10"
        >
          {
            Array.from({ length: 4 }, (_, i) => (
              <a href="/resources" class="group w-full">
                <p class="text-sm font-normal text-white/50">26/07/2026</p>
                <div class="mt-4 h-[180px] sm:h-[200px] w-full overflow-hidden rounded-lg">
                  <img
                    src={`/images/backgrounds/deco-${i + 1}.png`}
                    alt=""
                    class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <h3 class="mt-4 text-xs sm:text-sm lg:text-base font-normal text-white group-hover:text-purple-300 transition-colors">
                  lorem ipsum dolor sit amet consecte adipiscing elit sed...
                </h3>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section id="faq" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <SectionHeader title="Câu hỏi thường gặp" leftPercent={0} client:load />
        <div class="space-y-4 max-w-[1520px]">
          {
            faqList.map((item, i) => (
              <details
                class="group rounded-2xl border border-white/10 backdrop-blur-sm"
                style="background:rgba(255,255,255,0.02)"
                open={i === 0}
              >
                <summary class="flex cursor-pointer items-center justify-between px-4 sm:px-6 py-3.5 sm:py-5 text-sm sm:text-base md:text-lg font-medium text-white hover:text-purple-300 transition-colors">
                  <span>{item.question}</span>
                  <svg
                    class="h-5 w-5 shrink-0 ml-4 transition-transform group-open:rotate-180 text-purple-400"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M5 7.5L10 12.5L15 7.5" />
                  </svg>
                </summary>
                <div class="px-4 sm:px-6 pb-4 sm:pb-5 text-xs sm:text-sm md:text-base font-normal text-white/70 leading-relaxed">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
