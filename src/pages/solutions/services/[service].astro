---

<Layout title={`${title} | Cloudino`}>
  <main class="bg-black">
    {/* Hero */}
    <section
      class="relative flex min-h-[550px] h-auto py-16 sm:py-24 lg:min-h-[850px] items-center overflow-hidden bg-black"
    >
      <img
        src="/images/backgrounds/AICC.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20 sm:opacity-50 mix-blend-screen filter brightness-90 sm:brightness-125 pointer-events-none"
      />
      <img
        src="/images/backgrounds/M&M.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-15 sm:opacity-40 mix-blend-screen filter brightness-90 sm:brightness-125 pointer-events-none"
      />
      {/* Light black overlay layer */}
      <div class="absolute inset-0 bg-black/20 pointer-events-none z-0"></div>
      <div
        class="relative z-10 mx-auto w-full max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px] text-center"
      >
        <div class="mx-auto max-w-[1519px]">
          <h1
            class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl 2xl:text-[110px] font-extrabold leading-none text-transparent bg-clip-text tracking-tight uppercase"
            style="background-image: linear-gradient(90deg, #9bb0d8 0%, #cbd2b8 15%, #ece289 35%, #d4cb7b 50%, #ea98b9 70%, #e877c8 88%, #dd65d8 100%); -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.85);"
          >
            {title}
          </h1>
          <p
            class="mt-4 mx-auto max-w-[780px] text-xs sm:text-sm md:text-base lg:text-lg font-normal text-white/90 leading-relaxed"
          >
            {
              heroDesc ||
                "Giúp doanh nghiệp phân tích bài toán theo từng ngành và đánh giá toàn diện sự sẵn sàng của dữ liệu, hạ tầng."
            }
          </p>
          <a
            href="/contact"
            class="mt-6 mx-auto inline-flex h-[42px] sm:h-[50px] px-6 sm:px-8 items-center justify-center rounded-full border border-purple-400/30 text-sm sm:text-base font-medium tracking-wide text-white backdrop-blur-md transition-all hover:bg-white hover:text-black shadow-[0_0_20px_rgba(168,85,247,0.3)]"
            style="background:rgba(255,255,255,0.05)"
          >
            LIÊN HỆ NGAY →
          </a>
        </div>
      </div>
    </section>

    {/* Tab navigation */}
    <section
      class="sticky top-[56px] md:top-[70px] z-30 bg-black/90 backdrop-blur-xl border-b border-white/10"
    >
      <div
        class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]"
      >
        <div
          class="flex overflow-x-auto scrollbar-none gap-2 sm:gap-4 md:gap-6 justify-start md:justify-center py-2 sm:py-0"
        >
          {
            [
              { label: "Giải pháp", href: "#story" },
              { label: "Khung triển khai", href: "#framework" },
              { label: "Giải thưởng", href: "#awards" },
              { label: "Case Stories", href: "#case-stories" },
              { label: "Insights", href: "#insight" },
              { label: "Hỏi đáp", href: "#faq" },
            ].map((tab) => (
              <a
                href={tab.href}
                class="px-3 sm:px-4 py-2.5 sm:py-3.5 text-xs sm:text-sm lg:text-base font-normal text-white/70 whitespace-nowrap transition-colors hover:text-white border-b-2 border-transparent hover:border-purple-400"
              >
                {tab.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* Stats */}
    <section class="bg-black py-12 sm:py-16">
      <div
        class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]"
      >
        <Stats stats={stats} />

        <div class="mt-8 sm:mt-12 flex flex-col items-center gap-3 sm:gap-6">
          <h3
            class="text-lg sm:text-2xl lg:text-3xl font-light text-white max-w-[800px] text-center"
          >
            Đối tác được tin chọn bởi hơn 80% doanh nghiệp lớn trong nước
          </h3>
          <p
            class="text-xs sm:text-sm font-normal text-white/70 max-w-[406px] text-center"
          >
            Khẳng định giá trị kinh doanh đột phá dựa trên những dự án thành
            công thực tiễn cùng nền tảng dữ liệu quy mô lớn.
          </p>
        </div>

        <div
          class="mt-8 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4 items-center"
        >
          {
            Array.from({ length: 8 }, (_, i) => (
              <div class="flex h-24 sm:h-36 w-full items-center justify-center p-2">
                <img
                  src={`/images/logos-cleaned/${i + 1}.png`}
                  alt=""
                  class="max-h-full max-w-full object-contain filter brightness-90 hover:brightness-100 transition-all"
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Trusted Partner / Key Pillars */}
    {
      pillars && (
        <section class="bg-black py-12 sm:py-20 lg:py-24 border-t border-white/10">
          <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
            <div class="flex flex-col lg:flex-row gap-8 lg:gap-16 items-start">
              <div class="w-full lg:w-[480px] shrink-0">
                <h2 class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-light text-white leading-snug">
                  {trustedTitle || "Đối tác Tin cậy cho Chuyển đổi Số"}
                </h2>
                <a
                  href="/contact"
                  class="mt-6 sm:mt-8 inline-flex h-[50px] sm:h-[60px] w-[180px] sm:w-[201px] items-center justify-center rounded-full border border-purple-400/80 text-base sm:text-xl font-normal tracking-tight text-white backdrop-blur-md transition-all hover:bg-white hover:text-black bg-purple-900/40 shadow-[0_0_25px_rgba(125,81,211,0.4)] hover:scale-105"
                >
                  CONTACT US →
                </a>
              </div>
              <div class="flex-1 space-y-8 sm:space-y-10">
                {pillars.map((item: any) => (
                  <div>
                    <h3 class="text-xl sm:text-2xl lg:text-3xl xl:text-4xl font-normal text-white leading-snug">
                      {item.title}
                    </h3>
                    <p class="mt-2 text-xs sm:text-sm md:text-base font-normal text-white/70 leading-relaxed">
                      {item.desc}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      )
    }

    {/* Customer Success Story */}
    <section class="bg-black py-12 sm:py-20 lg:py-24">
      <div
        class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]"
      >
        <div
          class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-center justify-between"
        >
          <div class="flex-1 max-w-[870px]">
            <p
              class="text-xs sm:text-sm font-normal text-purple-400 uppercase tracking-wider"
            >
              Khách hàng tiêu biểu: Hãng hàng không Quốc tế
            </p>
            <h2
              class="mt-2 text-base sm:text-xl lg:text-2xl xl:text-3xl font-light text-white leading-tight"
            >
              Ngăn chặn sớm các lỗ hổng bảo mật ẩn và rủi ro thực tế với Giải
              pháp quản trị an ninh tích hợp CNAPP
            </h2>
            <p
              class="mt-3 text-xs sm:text-sm font-normal text-white/70 max-w-[548px] leading-relaxed"
            >
              Quản lý tập trung mọi dữ liệu bảo mật rải rác trên một nền tảng
              duy nhất, giúp doanh nghiệp dễ dàng kiểm soát các "điểm mù" an
              ninh và rủi ro tấn công trên toàn bộ môi trường đa đám mây
              (multi-cloud).
            </p>
          </div>
          <img
            src="/images/hero/hero-graphic.png"
            alt=""
            class="h-[280px] w-[280px] sm:h-[380px] sm:w-[380px] lg:h-[480px] lg:w-[480px] shrink-0 object-contain opacity-70"
          />
        </div>
      </div>
    </section>

    {/* Explore Solutions */}
    <section id="story" class="bg-black py-12 sm:py-20 lg:py-24">
      <div
        class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]"
      >
        <SectionHeader title="Khám phá Giải pháp" leftPercent={0} client:load />
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-10"
        >
          {
            exploreSolutions.map((item: any) => (
              <div
                class="w-full rounded-2xl border border-white/10 p-6 sm:p-8 backdrop-blur-sm flex flex-col justify-between hover:border-purple-400/50 transition-all duration-300"
                style="background:rgba(255,255,255,0.02)"
              >
                <div>
                  <img
                    src={item.image}
                    alt={item.title}
                    class="h-[180px] sm:h-[235px] w-full rounded-lg object-cover"
                  />
                  <h3 class="mt-4 text-base sm:text-lg lg:text-xl font-bold text-white leading-snug">
                    {item.title}
                  </h3>
                  <p class="mt-2.5 text-xs sm:text-sm font-normal text-white/70 leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Framework */}
    <section
      id="framework"
      class="bg-black py-12 sm:py-20 lg:py-24 relative overflow-hidden"
    >
      <div
        class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]"
      >
        <SectionHeader
          title="Quy trình triển khai"
          leftPercent={0}
          client:load
        />

        {/* Card Grid Container with Dotted Connecting Line */}
        <div class="relative">
          {/* Dotted connecting line in background */}
          <div
            class="hidden md:block absolute top-[60px] left-[15%] right-[15%] h-[2px] pointer-events-none z-0"
          >
            <svg class="w-full h-[60px] overflow-visible" fill="none">
              <path
                d="M 0 0 C 150 30, 250 -20, 400 10 C 550 40, 750 -10, 900 0"
                stroke="rgba(168, 85, 247, 0.4)"
                stroke-width="2"
                stroke-dasharray="6 6"></path>
            </svg>
          </div>

          <div
            class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8"
          >
            {
              frameworkSteps.map((item: any) => (
                <div
                  class="group flex flex-col items-center text-center rounded-[28px] border border-purple-500/30 p-8 sm:p-10 backdrop-blur-xl transition-all duration-300 hover:border-purple-400/70 hover:shadow-[0_0_35px_rgba(168,85,247,0.3)] hover:-translate-y-1.5"
                  style="background: linear-gradient(180deg, rgba(46, 18, 68, 0.65) 0%, rgba(20, 8, 32, 0.85) 100%);"
                >
                  {/* Purple Gradient Circle Badge */}
                  <div class="flex h-16 w-16 sm:h-20 sm:w-20 items-center justify-center rounded-full bg-gradient-to-b from-[#8b5cf6] to-[#5b21b6] text-xl sm:text-2xl font-medium text-white shadow-[0_0_20px_rgba(139,92,246,0.5)] border border-purple-300/30 shrink-0">
                    {item.step}
                  </div>

                  {/* Title */}
                  <h3 class="mt-6 text-base sm:text-lg lg:text-xl font-medium text-white leading-snug text-center">
                    {item.title}
                  </h3>

                  {/* Description */}
                  <p class="mt-3 text-xs sm:text-sm font-normal text-white/75 leading-relaxed text-center">
                    {item.desc}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* Awards */}
    <section id="awards" class="bg-black py-12 sm:py-20 lg:py-24">
      <div
        class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]"
      >
        <SectionHeader
          title="Giải thưởng & Chứng nhận"
          leftPercent={0}
          client:load
        />
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
          {
            awardsList.map((item: any) => (
              <div
                class="group flex flex-col items-center text-center rounded-[28px] border border-purple-500/30 p-8 sm:p-10 backdrop-blur-xl transition-all duration-300 hover:border-purple-400/70 hover:shadow-[0_0_35px_rgba(168,85,247,0.3)] hover:-translate-y-1.5"
                style="background: linear-gradient(180deg, rgba(46, 18, 68, 0.65) 0%, rgba(20, 8, 32, 0.85) 100%);"
              >
                {/* Center Award Image / Laurel Graphic */}
                <div class="my-4 sm:my-6 flex h-[150px] sm:h-[200px] w-full items-center justify-center">
                  <img
                    src={item.image}
                    alt=""
                    class="max-h-full max-w-[280px] sm:max-w-[340px] object-contain transition-transform duration-500 group-hover:scale-105"
                    style="filter: drop-shadow(0 0 25px rgba(168, 85, 247, 0.45));"
                  />
                </div>

                {/* Description */}
                <p class="text-xs sm:text-sm font-normal text-white/80 leading-relaxed text-center">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Case Stories */}
    <CaseStoriesSection />

    {/* Insights */}
    <section id="insight" class="bg-black py-12 sm:py-20 lg:py-24">
      <div
        class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]"
      >
        <SectionHeader title="Insights" leftPercent={0} client:load />
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-10"
        >
          {
            insights.map((item) => (
              <a
                href={`/resources/${item.slug}`}
                class="group flex flex-col justify-between rounded-3xl border border-purple-500/20 p-5 sm:p-6 bg-purple-950/20 backdrop-blur-sm transition-all duration-300 hover:border-purple-400/60 hover:bg-purple-900/40 hover:-translate-y-1.5 shadow-[0_4px_20px_rgba(0,0,0,0.4)]"
              >
                <div>
                  <div class="flex items-center justify-between text-xs text-white/60 mb-3">
                    <span>{item.date}</span>
                    <span class="px-2.5 py-0.5 rounded-full bg-purple-900/60 text-purple-300 font-medium border border-purple-400/30">
                      {item.category}
                    </span>
                  </div>
                  <div class="aspect-video w-full overflow-hidden rounded-2xl">
                    <img
                      src={item.image}
                      alt={item.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                  <h3 class="mt-4 text-base sm:text-lg font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-2">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-xs sm:text-sm font-normal text-white/70 line-clamp-3">
                    {item.description}
                  </p>
                </div>
                <div class="mt-6 flex h-10 w-[140px] items-center justify-center rounded-full border border-purple-400/50 text-xs font-medium text-white backdrop-blur-xl bg-gradient-to-r from-[#312e81] via-[#5b3db5] to-[#7d51d3] group-hover:bg-white group-hover:text-[#201048] shadow-[0_0_15px_rgba(168,85,247,0.3)] transition-all duration-300">
                  XEM CHI TIẾT →
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section id="faq" class="bg-black py-12 sm:py-20 lg:py-24">
      <div
        class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]"
      >
        <SectionHeader title="Câu hỏi thường gặp" leftPercent={0} client:load />
        <div class="space-y-4 max-w-[1520px]">
          {
            faqList.map((item, i) => (
              <details
                class="group rounded-2xl border border-white/10 backdrop-blur-sm"
                style="background:rgba(255,255,255,0.02)"
                open={i === 0}
              >
                <summary class="flex cursor-pointer items-center justify-between px-4 sm:px-6 py-3.5 sm:py-5 text-sm sm:text-base md:text-lg font-medium text-white hover:text-purple-300 transition-colors">
                  <span>{item.question}</span>
                  <svg
                    class="h-5 w-5 shrink-0 ml-4 transition-transform group-open:rotate-180 text-purple-400"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M5 7.5L10 12.5L15 7.5" />
                  </svg>
                </summary>
                <div class="px-4 sm:px-6 pb-4 sm:pb-5 text-xs sm:text-sm md:text-base font-normal text-white/70 leading-relaxed">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
