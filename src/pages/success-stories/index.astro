---
import SuccessStoriesCardGrids from "../../components/SuccessStoriesCardGrids";
import Layout from "../../layouts/Layout.astro";

const cases = [
  {
    title:
      "[ViMeeting+] An Automated Multilingual Meeting Transcription and Summarization Application",
    subtext:
      "Mastering Meeting Data: Automating Transcription and Summarization with Generative AI on AWS",
    image: "/images/backgrounds/ViMeeting+.jpg",
  },
  {
    title:
      "MaxcomGroup – AI Chatbots: Elevating the Customer Experience for AIGENX",
    subtext:
      "Discover how AIGENX leverages AWS GenAI to enhance customer engagement, improve response accuracy, and scale seamlessly while upholding top-tier security standards.",
    image: "/images/backgrounds/MaxcomGroup.jpg",
  },
  {
    title:
      "Masan - Accelerating Growth and Saving Costs with the AWS Cloud Transformation Journey",
    subtext:
      "Masan, one of the leading consumer goods companies in Vietnam, faced numerous challenges with its on-premise infrastructure, including limited scalability, high costs, and a lack of flexibility.",
    image: "/images/backgrounds/Masan.jpg",
  },
  {
    title:
      "De Heus Vietnam - Nurturing the Mission to Deliver a Clean Food Chain Globally",
    subtext: "",
    image: "/images/backgrounds/De Heus Việt Nam.jpg",
  },
  {
    title:
      "Urbox - The Exclusive Digital Gifting Platform Operating on a SaaS and API Model",
    subtext: "",
    image: "/images/backgrounds/Urbox.jpg",
  },
];
---

<Layout title="Success Stories | Cloudino">
  <main class="bg-black">
    <section
      class="relative flex h-[930px] items-center overflow-hidden bg-black"
    >
      <img
        src="/images/backgrounds/M&M.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20 mix-blend-lighten"
      />
      <div
        class="relative mx-auto w-full max-w-[1920px] px-[285px] text-center"
      >
        <p class="text-2xl font-normal text-white">
          We accompany our customers on their innovation journey
        </p>
        <h1
          class="mt-4 mx-auto max-w-[1151px] text-[64px] font-bold leading-[1.5] text-transparent bg-clip-text uppercase"
          style="background-image:linear-gradient(45deg,#5B6FF5,#D4CB7B 52.6%,#DA3FF0)"
        >
          Explore cloudino&apos;s DX capabilities through customer success
          stories across industries
        </h1>
      </div>
    </section>

    <section class="bg-black pb-8">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="flex gap-4 justify-center">
          {
            ["All", "Service", "Platform", "Industry"].map(tag => (
              <button class="flex flex-col items-start rounded-full px-6 py-3 text-white/70 transition-all hover:border-white/40 hover:text-white">
                <span class="text-2xl font-normal">{tag}</span>
              </button>
            ))
          }
        </div>
      </div>
    </section>
    <section class="relative overflow-hidden bg-black pt-[100px] pb-[55px]">
      <img
        src="/images/backgrounds/bg-section-6.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-60"
      />

      <div class="mb-[25px] flex items-center">
        <div
          class="relative flex items-center overflow-hidden rounded-full border border-accent px-6 py-3"
          style={{
            background: "rgba(49,46,129,0.25)",
            backdropFilter: "blur(16px)",
          }}
        >
          <div
            class="absolute left-0 top-1/2 -translate-x-1/2 -translate-y-1/2"
          >
            <div class="h-4 w-4 rounded-full bg-white opacity-30 blur-[2px]">
            </div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="h-2 w-2 rounded-full bg-white opacity-40"></div>
            </div>
          </div>
          <h2 class="text-5xl font-light text-white">Featured case stories</h2>
          <div
            class="absolute right-0 top-1/2 translate-x-1/2 -translate-y-1/2"
          >
            <div class="h-4 w-4 rounded-full bg-white opacity-30 blur-[2px]">
            </div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="h-2 w-2 rounded-full bg-white opacity-40"></div>
            </div>
          </div>
        </div>
        <div class="ml-0 flex-1 border-dashed border border-white/20"></div>
        <img
          src="/images/partners/logo-1.png"
          alt=""
          class="ml-0 h-[50px] w-[296px] object-contain"
        />
      </div>
      <SuccessStoriesCardGrids />
    </section>
    <section class="bg-black pb-8">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">All Case Stories(5)</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-3 gap-10">
          {
            cases.map((item, i) => (
              <a
                href={`/success-stories/${i + 1}`}
                class="group bg-accent/40 p-4 rounded-4xl"
              >
                <div class="h-[440px] overflow-hidden rounded-lg">
                  <img
                    src={item.image}
                    alt=""
                    class="h-full w-full object-cover"
                  />
                </div>
                <h3 class="mt-4 text-2xl font-bold text-white group-hover:text-primary">
                  {item.title}
                </h3>
                <p class="mt-2 text-base font-normal text-white">
                  {item.subtext}
                </p>
                <div
                  class="mt-6 flex h-[48px] sm:h-[60px] w-[170px] sm:w-[194px] items-center justify-center rounded-full border border-purple-400/50 text-base sm:text-xl font-medium tracking-[-0.5px] text-white backdrop-blur-xl bg-gradient-to-r from-[#312e81] via-[#5b3db5] to-[#7d51d3] hover:bg-white hover:text-[#201048] shadow-[0_0_25px_rgba(168,85,247,0.45)] hover:shadow-[0_0_35px_rgba(168,85,247,0.75)] hover:scale-105 transition-all duration-300"
                >
                  LEARN MORE →
                </div>
              </a>
            ))
          }
        </div>

        <!-- <div class="mt-12 flex items-center justify-center gap-6">
          <button
            class="text-5xl font-light text-white/40 hover:text-white transition-colors"
            >&larr;</button
          >
          {
            ["1", "2", "3", "4", "..."].map(p => (
              <button
                class={`text-2xl font-normal transition-colors ${p === "1" ? "text-white" : "text-white/40 hover:text-white"}`}
              >
                {p}
              </button>
            ))
          }
          <button
            class="text-5xl font-light text-white/40 hover:text-white transition-colors"
            >&rarr;</button
          >
        </div> -->
      </div>
    </section>

    <section class="bg-black py-24">
      <div class="mx-auto max-w-[1920px] px-[285px] text-center">
        <div class="mb-8 flex items-center">
          <h2 class="text-5xl font-light text-white">Certification</h2>
          <div class="ml-0 flex-1 border-t border-white/20"></div>
        </div>
        <h2 class="text-5xl font-light text-white">
          Global Partnerships and Certifications
        </h2>
        <p class="mt-2 text-base font-normal text-white/70">
          We possess globally recognized technical expertise and service
          quality.
        </p>
        <div class="relative flex shrink-0 items-start">
          <div class="p-2 bg-linear-to-r from-[#312E81] to-accent rounded-2xl">
            <img
              src="/images/aws/aws-badge.png"
              alt="AWS Badge"
              class="h-64 w-48 object-contain"
            />
          </div>
          <img
            src="/images/aws/aws-icon.png"
            alt=""
            class="mt-[200px] -ml-[90px] h-32 w-32 object-contain"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>
