const { platform } = Astro.params;

const page = pages.find(page => page.platform === platform);
if (!page) return Astro.redirect("/404");
---

<Layout title="AWS Enterprise Cloud | Cloudino">
  <main class="bg-black">
    {/* Hero */}
    <section
      class="relative flex h-[930px] items-center overflow-hidden bg-black"
    >
      <img
        src="/images/backgrounds/AICC.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-30 mix-blend-lighten"
      />
      <img
        src="/images/backgrounds/M&M.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20 mix-blend-lighten"
      />
      <div
        class="relative mx-auto w-full max-w-[1920px] px-[285px] text-center"
      >
        <div class="mx-auto max-w-[1519px]">
          <h1
            class="text-[128px] font-bold leading-none text-transparent bg-clip-text"
            style="background-image:linear-gradient(45deg,#5B6FF5,#D4CB7B 52.6%,#DA3FF0)"
          >
            {page.title}
          </h1>
          <p
            class="mt-6 mx-auto max-w-[740px] text-base font-normal text-white"
          >
            {page.subtitle}
          </p>
          <a
            href="/contact"
            class="mt-8 mx-auto inline-flex h-[60px] w-[201px] items-center justify-center rounded-full border border-accent text-xl font-normal tracking-[-1px] text-white backdrop-blur-md transition-all hover:bg-white hover:text-accent bg-accent/40"
          >
            {page.button} →
