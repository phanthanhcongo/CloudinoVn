---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About us | Cloudino">
  <main class="pt-[101px] bg-black">
    <section class="py-[137px]">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <h1 class="text-[96px] font-light text-white">About us</h1>
        <p class="mt-0 max-w-3xl text-base text-white/60">
          Countless companies have achieved digital innovation with Cloudino. We
          support customers in innovating faster and smarter—from on-premises to
          cloud-native.
        </p>
      </div>
    </section>
    <section class="border-t border-white/20 py-[137px]">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <h2 class="text-5xl font-light text-white">Cloudino</h2>
        <p class="mt-0 text-2xl text-white/80">
          A Journey of Innovation from Cloud to AI
        </p>
        <p class="mt-0 max-w-3xl text-base text-white/60">
          Based on our cloud innovation experience, Cloudino is a trusted
          partner that leads customers&apos; proactive growth in the AI era.
        </p>
      </div>
    </section>
    <section class="border-t border-white/20 py-[137px]">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <div class="grid grid-cols-4 gap-10">
          {[
            { value: "99+", label: "Cloud Projects" },
            { value: "9+", label: "Certified Experts" },
            { value: "999+", label: "Global Technology Partners" },
            { value: "99%", label: "Service Availability" },
          ].map((stat) => (
            <div>
              <span class="text-[96px] font-light text-white">{stat.value}</span>
              <p class="mt-3 text-2xl text-white/50">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
