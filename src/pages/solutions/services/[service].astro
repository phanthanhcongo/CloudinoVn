---
import Stats from "../../../components/Stats";
import Layout from "../../../layouts/Layout.astro";

export function getStaticPaths() {
  return [{ params: { service: "ai-data" } }];
}

const cases = [
  {
    title:
      "[ViMeeting+] Ứng dụng tự động hóa quy trình phiên âm và tóm tắt cuộc họp đa ngôn ngữ",
    subtext:
      "Làm chủ dữ liệu cuộc họp: Tự động hoá phiên âm và tóm tắt cuộc họp với Generative AI trên AWS",
    image: "/images/backgrounds/ViMeeting+.jpg",
  },
  {
    title:
      "MaxcomGroup – Chatbot AI Nâng Tầm Trải Nghiệm Khách Hàng Cho AIGENX",
    subtext:
      "Tìm hiểu cách AIGENX tận dụng AWS GenAI để cải thiện tương tác khách hàng, nâng cao độ chính xác phản hồi và mở rộng quy mô linh hoạt mà vẫn đảm bảo bảo mật hàng đầu.",
    image: "/images/backgrounds/MaxcomGroup.jpg",
  },
  {
    title:
      "Masan - Bứt Phá Tăng Trưởng, Tiết Kiệm Chi Phí với Hành Trình Chuyển Đổi Lên Đám Mây AWS",
    subtext:
      "Masan, một trong những công ty hàng tiêu dùng hàng đầu Việt Nam, đã đối mặt với nhiều thách thức về hạ tầng tại chỗ, bao gồm khả năng mở rộng hạn chế, chi phí cao và sự thiếu linh hoạt. Để giải quyết những vấn đề này, Masan đã hợp tác với Cloudino, đối tác tư vấn AWS hàng đầu tại Việt Nam, để chuyển đổi hệ thống của mình lên đám mây AWS.",
    image: "/images/backgrounds/Masan.jpg",
  },
];

const stats = [
  { value: "1000+", label: "Cloud-based AI/ML and data projects delivery" },
  { value: "200K+", label: "Clients served in AI & Data projects" },
  { value: "99+", label: "Specialized AI & Data engineers" },
];
---

<Layout title="AI & Data | Cloudino">
  <main class="bg-black">
    {/* Hero */}
    <section
      class="relative flex min-h-[550px] h-auto py-16 sm:py-24 lg:min-h-[850px] items-center overflow-hidden bg-black"
    >
      <img
        src="/images/backgrounds/AICC.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20 sm:opacity-50 mix-blend-screen filter brightness-90 sm:brightness-125 pointer-events-none"
      />
      <img
        src="/images/backgrounds/M&M.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-15 sm:opacity-40 mix-blend-screen filter brightness-90 sm:brightness-125 pointer-events-none"
      />
      {/* Light black overlay layer */}
      <div class="absolute inset-0 bg-black/20 pointer-events-none z-0" />
      <div
        class="relative z-10 mx-auto w-full max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px] text-center"
      >
        <div class="mx-auto max-w-[1519px]">
          <h1
            class="text-5xl sm:text-7xl md:text-9xl xl:text-[135px] font-extrabold leading-none text-transparent bg-clip-text tracking-tight uppercase"
            style="background-image: linear-gradient(90deg, #9bb0d8 0%, #cbd2b8 15%, #ece289 35%, #d4cb7b 50%, #ea98b9 70%, #e877c8 88%, #dd65d8 100%); -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.85);"
          >
            AI & Data
          </h1>
          <p
            class="mt-6 mx-auto max-w-[740px] text-sm sm:text-base md:text-xl font-normal text-white/90 leading-relaxed"
          >
            Giúp doanh nghiệp phân tích bài toán theo từng ngành và đánh giá
            toàn diện sự sẵn sàng của dữ liệu, hạ tầng.
          </p>
          <a
            href="/contact"
            class="mt-8 mx-auto inline-flex h-[50px] sm:h-[60px] px-8 sm:px-10 items-center justify-center rounded-full border border-purple-400/30 text-base sm:text-xl font-medium tracking-wide text-white backdrop-blur-md transition-all hover:bg-white hover:text-black shadow-[0_0_20px_rgba(168,85,247,0.3)]"
            style="background:rgba(255,255,255,0.05)"
          >
            CONTACT US →
          </a>
        </div>
      </div>
    </section>

    {/* Tab navigation */}
    <section
      class="sticky top-[70px] sm:top-[90px] md:top-[101px] z-30 bg-black/90 backdrop-blur-xl border-b border-white/10"
    >
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px]">
        <div class="flex overflow-x-auto scrollbar-none gap-2 sm:gap-4 md:gap-6 justify-start md:justify-center py-2 sm:py-0">
          {
            [
              "Story",
              "Overview",
              "Framework",
              "Awards",
              "Case Stories",
              "Insight",
              "FAQ",
            ].map(tab => (
              <a
                href={`#${tab.toLowerCase().replace(/\s+/g, "-")}`}
                class="px-3 sm:px-6 py-3 sm:py-4 text-sm sm:text-lg md:text-2xl font-normal text-white/70 whitespace-nowrap transition-colors hover:text-white border-b-2 border-transparent hover:border-purple-400"
              >
                {tab}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* Stats */}
    <section class="bg-black py-12 sm:py-16">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px]">
        <Stats stats={stats} />

        <div class="mt-8 sm:mt-12 flex flex-col items-center gap-4 sm:gap-8">
          <h3 class="text-2xl sm:text-4xl lg:text-5xl font-light text-white max-w-[900px] text-center">
            Đối tác được tin chọn bởi hơn 80% doanh nghiệp lớn trong nước
          </h3>
          <p
            class="text-sm sm:text-base font-normal text-white/70 max-w-[406px] text-center"
          >
            Khẳng định giá trị kinh doanh đột phá dựa trên những dự án thành
            công thực tiễn cùng nền tảng dữ liệu quy mô lớn.
          </p>
        </div>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4 items-center">
          {
            Array.from({ length: 8 }, (_, i) => (
              <div class="flex h-24 sm:h-36 w-full items-center justify-center p-2">
                <img
                  src={`/images/logos-cleaned/${i + 1}.png`}
                  alt=""
                  class="max-h-full max-w-full object-contain filter brightness-90 hover:brightness-100 transition-all"
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Customer Success Story */}
    <section class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px]">
        <div class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-center justify-between">
          <div class="flex-1 max-w-[870px]">
            <p class="text-sm sm:text-base font-normal text-purple-400 uppercase tracking-wider">
              Customer Success Story Global Airline
            </p>
            <h2 class="mt-2 text-2xl sm:text-4xl lg:text-5xl font-light text-white leading-tight">
              Proactively identify hidden attack paths and tangible risks
              through CNAPP-based integrated security governance
            </h2>
            <p class="mt-4 text-sm sm:text-base font-normal text-white/70 max-w-[548px] leading-relaxed">
              By connecting dispersed cloud security information into one
              unified view, you can identify security blind spots and attack
              paths across multi-cloud environments at a glance.
            </p>
          </div>
          <img
            src="/images/hero/hero-graphic.png"
            alt=""
            class="h-[280px] w-[280px] sm:h-[380px] sm:w-[380px] lg:h-[480px] lg:w-[480px] shrink-0 object-contain opacity-70"
          />
        </div>
      </div>
    </section>

    {/* Explore Solutions */}
    <section id="story" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px]">
        <div class="mb-8 flex items-center gap-4">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-white whitespace-nowrap">Explore Solutions</h2>
          <div class="flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-10">
          {
            Array.from({ length: 3 }, (_, i) => (
              <div
                class="w-full rounded-2xl border border-white/10 p-6 sm:p-8 backdrop-blur-sm"
                style="background:rgba(255,255,255,0.02)"
              >
                <img
                  src={`/images/backgrounds/deco-${i + 1}.png`}
                  alt=""
                  class="h-[180px] sm:h-[235px] w-full rounded-lg object-cover"
                />
                <h3 class="mt-4 text-xl sm:text-2xl font-normal text-white leading-snug">
                  lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                  diam nonummy nibh euismod
                </h3>
                <p class="mt-2 text-sm sm:text-base font-normal text-white/60 leading-relaxed">
                  lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                  diam nonummy nibh euismod tincidunt ut lorem ipsum dolor sit
                  amet consectetuer adipiscing elit sed diam nonummy nibh
                  euismod tincidunt ut
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Framework */}
    <section id="framework" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px]">
        <div class="mb-8 flex items-center gap-4">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-white whitespace-nowrap">Framework</h2>
          <div class="flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-10">
          {
            ["01", "02", "03"].map((num, i) => (
              <div
                class="w-full rounded-2xl border border-white/10 p-6 sm:p-8 backdrop-blur-sm"
                style="background:rgba(255,255,255,0.02)"
              >
                <div
                  class="flex h-[70px] w-[70px] sm:h-[100px] sm:w-[100px] items-center justify-center rounded-full border border-white/10"
                  style="background:rgba(49,46,129,0.2)"
                >
                  <span class="text-2xl sm:text-4xl font-normal text-white">{num}</span>
                </div>
                <h3 class="mt-6 text-xl sm:text-2xl font-normal text-white leading-snug">
                  lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                  diam nonummy nibh euismod
                </h3>
                <p class="mt-2 text-sm sm:text-base font-normal text-white/60 leading-relaxed">
                  lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                  diam nonummy nibh euismod tincidunt ut
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Awards */}
    <section id="awards" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px]">
        <div class="mb-8 flex items-center gap-4">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-white whitespace-nowrap">Awards</h2>
          <div class="flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
          {
            Array.from({ length: 2 }, (_, i) => (
              <div
                class="flex flex-col sm:flex-row gap-6 sm:gap-8 rounded-2xl border border-white/10 p-6 sm:p-8 backdrop-blur-sm"
                style="background:rgba(255,255,255,0.02)"
              >
                <img
                  src={`/images/backgrounds/deco-${i + 1}.png`}
                  alt=""
                  class="h-[180px] sm:h-[190px] w-full sm:w-[285px] shrink-0 rounded-lg object-cover"
                />
                <div>
                  <h3 class="text-xl sm:text-2xl font-normal text-white leading-snug">
                    lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                    diam nonummy nibh euismod
                  </h3>
                  <p class="mt-2 text-sm sm:text-base font-normal text-white/60 leading-relaxed">
                    lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                    diam nonummy nibh euismod tincidunt ut
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Case Stories */}
    <section id="case-stories" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px]">
        <div class="mb-8 flex items-center gap-4">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-white whitespace-nowrap">Case Stories</h2>
          <div class="flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-10">
          {
            cases.map((item, i) => (
              <a
                href={`/success-stories/${i + 1}`}
                class="group bg-purple-950/30 border border-purple-500/20 p-4 sm:p-6 rounded-3xl transition-all duration-300 hover:border-purple-400/50 hover:bg-purple-900/40 flex flex-col justify-between"
              >
                <div>
                  <div class="h-[220px] sm:h-[300px] lg:h-[360px] overflow-hidden rounded-xl">
                    <img
                      src={item.image}
                      alt=""
                      class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                  <h3 class="mt-4 text-xl sm:text-2xl font-bold text-white group-hover:text-purple-300 transition-colors">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-sm sm:text-base font-normal text-white/80 line-clamp-3">
                    {item.subtext}
                  </p>
                </div>
                <div
                  class="mt-6 flex h-[48px] sm:h-[56px] w-[160px] sm:w-[194px] items-center justify-center rounded-full border border-purple-400/50 text-sm sm:text-lg font-medium tracking-tight text-white backdrop-blur-xl bg-gradient-to-r from-[#312e81] via-[#5b3db5] to-[#7d51d3] hover:bg-white hover:text-[#201048] shadow-[0_0_25px_rgba(168,85,247,0.45)] hover:shadow-[0_0_35px_rgba(168,85,247,0.75)] hover:scale-105 transition-all duration-300"
                >
                  LEARN MORE →
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* Insights */}
    <section id="insight" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px]">
        <div class="mb-8 flex items-center gap-4">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-white whitespace-nowrap">Insights</h2>
          <div class="flex-1 border-t border-white/20"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-10">
          {
            Array.from({ length: 4 }, (_, i) => (
              <a href="/resources" class="group w-full">
                <p class="text-sm font-normal text-white/50">26/07/2026</p>
                <div class="mt-4 h-[180px] sm:h-[200px] w-full overflow-hidden rounded-lg">
                  <img
                    src={`/images/backgrounds/deco-${i + 1}.png`}
                    alt=""
                    class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <h3 class="mt-4 text-base sm:text-xl font-normal text-white group-hover:text-purple-300 transition-colors">
                  lorem ipsum dolor sit amet consecte adipiscing elit sed...
                </h3>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section id="faq" class="bg-black py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-16 xl:px-[285px]">
        <div class="mb-8 flex items-center gap-4">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-white whitespace-nowrap">FAQ</h2>
          <div class="flex-1 border-t border-white/20"></div>
        </div>
        <div class="space-y-4 max-w-[1520px]">
          {
            Array.from({ length: 8 }, (_, i) => (
              <details
                class="group rounded-2xl border border-white/10 backdrop-blur-sm"
                style="background:rgba(255,255,255,0.02)"
              >
                <summary class="flex cursor-pointer items-center justify-between px-4 sm:px-8 py-4 sm:py-6 text-sm sm:text-base font-normal text-white">
                  <span>
                    lorem ipsum dolor sit amet consectetuer adipiscing elit sed
                    diam nonummy nibh euismod tincidunt ut
                  </span>
                  <svg
                    class="h-5 w-5 shrink-0 ml-4 transition-transform group-open:rotate-180"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="1.5"
                  >
                    <path d="M5 7.5L10 12.5L15 7.5" />
                  </svg>
                </summary>
                <div class="px-4 sm:px-8 pb-4 sm:pb-6 text-sm sm:text-base font-normal text-white/60 leading-relaxed">
                  {i === 1 ? (
                    <p>
                      lorem ipsum dolor sit amet consectetuer adipiscing elit
                      sed diam nonummy nibh euismod tincidunt ut lorem ipsum
