---
import Layout from "../../layouts/Layout.astro";
import Prose from "../../components/Prose.astro";
export function getStaticPaths() {
  return [
    { params: { position: "devops" } },
    { params: { position: "ai-engineer" } },
    { params: { position: "cloud-engineer" } },
  ];
}

const { position } = Astro.params;

const details = Object.values(
  import.meta.glob("../../job-details/*.md", { eager: true }),
);

const page = details.find((page: any) => {
  return page.frontmatter.simpleUrl === position;
}) as any;

if (!page) return Astro.redirect("/404");

const compiled = await page.compiledContent();
---

<Layout title={`${page.frontmatter.title} | Career`}>
  <main class="pt-[56px] md:pt-[70px] bg-black min-h-screen">
    <div class="py-8 sm:py-16 md:py-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Back button */}
      <div class="mb-6">
        <a
          href="/career"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-white/70 hover:text-white transition-colors py-2 px-3 rounded-lg bg-white/5 hover:bg-white/10"
        >
          &larr; Tất cả vị trí tuyển dụng
        </a>
      </div>

      {/* Header card */}
      <div
        class="w-full bg-accent/40 border border-accent p-6 sm:p-8 rounded-2xl sm:rounded-3xl shadow-xl"
      >
        <h1
          class="text-2xl sm:text-3xl md:text-4xl font-bold text-white tracking-tight"
        >
          {page.frontmatter.title}
        </h1>
        <div
          class="mt-4 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 text-white/80 text-sm sm:text-base"
        >
          <p>
            <strong class="text-white font-semibold">Location:</strong> Hà Nội
          </p>
          <span class="hidden sm:inline text-white/30">•</span>
          <p>
            <strong class="text-white font-semibold">Lương:</strong> Thỏa thuận theo
            năng lực
          </p>
        </div>
      </div>

      {/* Detail description */}
      <div
        class="mt-6 sm:mt-8 bg-[#080808] border border-accent/40 rounded-2xl p-6 sm:p-8 shadow-xl"
      >
        <Prose>
          <article set:html={compiled} />
        </Prose>
      </div>
    </div>
  </main>
</Layout>
