              {page.aboutUs.text}
            </h2>
            <p class="mt-4 text-base font-normal text-white/70 max-w-[548px]">
              {page.aboutUs.subtext}
            </p>
          </div>
          <img
            src="/images/icons/image 141.png"
            alt=""
            class="h-[480px] w-[480px] shrink-0 object-contain"
          />
        </div>
      </div>
    </section>

    <!-- {/* Large text */}
