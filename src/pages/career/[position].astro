---
import Layout from "../../layouts/Layout.astro";
import Prose from "../../components/Prose.astro";
export function getStaticPaths() {
  return [
    { params: { position: "devops" } },
    { params: { position: "ai-engineer" } },
    { params: { position: "cloud-engineer" } },
  ];
}

const { position } = Astro.params;

const details = Object.values(
  import.meta.glob("../../job-details/*.md", { eager: true }),
);

const page = details.find((page: any) => {
  return page.frontmatter.simpleUrl === position;
}) as any;

if (!page) return Astro.redirect("/404");

const compiled = await page.compiledContent();
---

<Layout title="Career">
  <div class="my-40 max-w-250 mx-auto">
    <div class="w-full bg-accent/40 border border-accent p-8 rounded-4xl">
      <h1 class="text-3xl font-bold">
        {page.frontmatter.title}
      </h1>
      <p>Location: Hà Nội</p>
      <p>Lương: Thỏa thuận theo năng lực</p>
    </div>
    <Prose>
      <article set:html={compiled} />
    </Prose>
  </div></Layout
>
