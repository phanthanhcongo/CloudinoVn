---
export interface Props {
  date?: string;
  name?: string;
  title: string;
  subtitle: string;
  image?: string;
  compiledContent: string;
}

const {
  date = "26/07/2026",
  name = "ViMeeting+",
  title,
  subtitle,
  image,
  compiledContent,
} = Astro.props;

// Split compiled content into two parts to insert the article image in the middle if image is provided
let contentFirstPart = compiledContent;
let contentSecondPart = "";

if (image && compiledContent) {
  const firstH1EndIndex = compiledContent.indexOf("</h1>");
  if (firstH1EndIndex !== -1) {
    const nextH1Index = compiledContent.indexOf("<h1", firstH1EndIndex);
    if (nextH1Index !== -1) {
      contentFirstPart = compiledContent.slice(0, nextH1Index);
      contentSecondPart = compiledContent.slice(nextH1Index);
    }
  }
}
---

<div class="bg-white text-gray-900 min-h-screen relative font-sans">
  {/* Sticky Floating Social Media Icons on Top Right (Hidden on Mobile) */}
  <div class="hidden md:flex fixed right-4 lg:right-6 top-44 z-50 flex-col gap-3">
    <button
      aria-label="Share"
      class="w-10 h-10 rounded-full bg-purple-100 hover:bg-purple-200 text-purple-700 flex items-center justify-center shadow-md transition-all duration-200 hover:scale-110"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"></path>
      </svg>
    </button>
    <button
      aria-label="Facebook"
      class="w-10 h-10 rounded-full bg-purple-100 hover:bg-purple-200 text-purple-700 flex items-center justify-center shadow-md transition-all duration-200 hover:scale-110"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H7.5v-3H10V9.5C10 7.01 11.49 5.6 13.78 5.6c1.1 0 2.25.2 2.25.2v2.47h-1.27c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 3h-2.33v6.8c4.56-.93 8-4.96 8-9.8z"></path>
      </svg>
    </button>
    <button
      aria-label="Twitter"
      class="w-10 h-10 rounded-full bg-purple-100 hover:bg-purple-200 text-purple-700 flex items-center justify-center shadow-md transition-all duration-200 hover:scale-110"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.05c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.58 8.58 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"></path>
      </svg>
    </button>
  </div>

  {/* Top Dark Background Section matching exact Header height */}
  <div class="w-full bg-black relative z-0 h-[66px] md:h-[103px]">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(125,81,211,0.3)_0%,transparent_75%)] pointer-events-none"></div>
  </div>

  <div class="mx-auto max-w-[1280px] px-4 sm:px-8 lg:px-12 pt-4 sm:pt-6 pb-16 sm:pb-24">
    {/* Back Button */}
    <div class="mb-6 sm:mb-8">
      <a
        href="/success-stories"
        class="inline-flex h-10 sm:h-11 px-5 sm:px-7 items-center justify-center rounded-full bg-gradient-to-r from-purple-500 to-indigo-600 text-white font-medium text-xs sm:text-sm tracking-wide shadow-md transition-all duration-300 hover:opacity-90 hover:shadow-lg hover:scale-105"
      >
        &larr; BACK
      </a>
    </div>

    {/* Hero Title Section Box */}
    <div
      class="relative overflow-hidden rounded-3xl sm:rounded-[40px] p-6 sm:p-12 lg:p-20 mb-10 sm:mb-16 border border-[#c6b7f7]"
      style="background: linear-gradient(135deg, #e6deff 0%, #d8cefc 100%);"
    >
      {/* 3D Glass Graphic centered behind/beside text */}
      <div class="absolute left-1/2 md:left-[45%] top-1/2 -translate-x-1/2 -translate-y-1/2 w-[220px] sm:w-[420px] lg:w-[580px] h-[220px] sm:h-[420px] lg:h-[580px] pointer-events-none opacity-20 sm:opacity-25 mix-blend-multiply z-0">
        <img
          src="/images/hero/hero-icon-3.png"
          alt=""
          class="w-full h-full object-contain"
        />
      </div>

      <div class="relative z-10 max-w-4xl">
        <span class="text-xs sm:text-sm font-normal text-gray-900 tracking-tight block mb-3 sm:mb-6">
          {date}
        </span>
        <h1 class="text-2xl sm:text-4xl lg:text-5xl xl:text-6xl font-semibold text-gray-900 leading-[1.2] sm:leading-[1.15] tracking-tight mb-4 sm:mb-8 font-sans">
          {title}
        </h1>
        <p class="text-sm sm:text-base md:text-lg font-normal text-gray-800 leading-relaxed max-w-2xl font-sans">
          {subtitle}
        </p>
      </div>
    </div>

    {/* Main Article Content Layout */}
    <div class="relative max-w-4xl mx-auto">
      {/* Article Body */}
      <div class="w-full">
        <div class="prose prose-base sm:prose-lg max-w-none font-sans text-gray-800 prose-headings:font-sans prose-headings:font-bold prose-headings:text-gray-900 prose-h1:text-2xl sm:prose-h1:text-3xl prose-h1:font-bold prose-h1:mt-8 sm:prose-h1:mt-10 prose-h1:mb-4 prose-h2:text-xl sm:prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-6 prose-h2:mb-3 prose-h3:text-lg sm:prose-h3:text-xl prose-h3:font-semibold prose-h3:mt-5 prose-h3:mb-2 prose-p:font-sans prose-p:text-gray-700 prose-p:leading-relaxed prose-p:text-base sm:prose-p:text-lg prose-p:my-4 sm:prose-p:my-5 prose-li:font-sans prose-li:text-gray-700 prose-li:text-base sm:prose-li:text-lg prose-strong:font-sans prose-strong:font-semibold prose-strong:text-gray-900 prose-em:font-sans prose-em:italic prose-img:rounded-2xl sm:prose-img:rounded-3xl prose-img:shadow-xl prose-img:my-6 sm:prose-img:my-8">
          <article set:html={contentFirstPart} class="w-full font-sans" />

          {/* Featured Article Image in Middle */}
          {image && (
            <div
              class="my-8 sm:my-14 w-full h-[200px] sm:h-[380px] lg:h-[500px] rounded-2xl sm:rounded-[32px] shadow-xl sm:shadow-2xl border border-purple-100 bg-cover bg-center"
              style={`background-image: url('${image}');`}
            ></div>
          )}

          {contentSecondPart && <article set:html={contentSecondPart} class="w-full font-sans" />}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  div, h1, h2, h3, h4, p, span, li, strong, em, article {
    font-family: 'Times New Roman', Times, serif !important;
  }
</style>
