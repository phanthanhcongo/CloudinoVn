---
import Stats from "../../../components/Stats";
import Layout from "../../../layouts/Layout.astro";
import SectionHeader from "../../../components/SectionHeader";
import CaseStoriesSection from "../../../components/CaseStoriesSection.astro";
import PurpleOrb from "../../../components/PurpleOrb";

export function getStaticPaths() {
  return [
    { params: { platform: "aws" } },
    { params: { platform: "digital-ocean" } },
    { params: { platform: "lark" } },
  ];
}

const pages = [
  {
    platform: "aws",
    title: "AWS CLOUD & AI TRANSFORMATION",
    subtitle:
      "Đồng hành cùng doanh nghiệp từng bước trên hành trình chuyển đổi số với các giải pháp tối ưu hạ tầng, giúp tăng tốc đổi mới, nâng cao hiệu quả vận hành và tối ưu chi phí.",
    button: "TƯ VẤN NGAY",
    aboutUs: {
      title: "VỀ CHÚNG TÔI",
      text: "Cung cấp dịch vụ tư vấn, triển khai, tối ưu và quản lý hạ tầng điện toán đám mây với đội ngũ chuyên gia được chứng nhận bởi AWS.",
      subtext:
        "Đơn vị Tư vấn & Cung cấp dịch vụ Điện toán đám mây hàng đầu Châu Á",
      cards: [
        {
          title: "10+ Năm Kinh Nghiệm",
          text: "Đồng hành cùng doanh nghiệp trên hành trình chuyển đổi Cloud.",
        },
        {
          title: "AWS Certified Team",
          text: "Đội ngũ chuyên gia sở hữu các chứng chỉ quốc tế từ AWS.",
        },
        {
          title: "Vietnam Cloud Community",
          text: "Kết nối và phát triển cộng đồng Cloud lớn mạnh tại Việt\u00A0Nam.",
        },
      ],
      cta: {
        title: "Cloudino Engineers",
        text: "Tư vấn, triển khai và tối ưu hạ tầng AWS bởi đội ngũ chuyên gia được chứng nhận.",
        subtext: "Kiến Tạo Nền Tảng Cloud Cho Tăng Trưởng Bền Vững",
      },
    },
    features: {
      cards: [
        {
          title: "Dịch Vụ Quản Lý Đám Mây: AWS Managed Services",
          text: "Dịch vụ quản lý hệ thống đám mây toàn diện, được thiết kế riêng cho từng khách hàng, giúp doanh nghiệp tập trung hoàn toàn vào phát triển kinh doanh, không còn lo lắng về hệ thống.",
        },
        {
          title: "Dịch vụ Thanh toán hóa đơn: AWS Billing Services",
          text: "Dễ dàng tìm thấy hóa đơn và dữ liệu thanh toán để phân tích hoặc kiểm tra lịch sử. Giúp doanh nghiệp quản lý chi phí đám mây hiệu quả, minh bạch và tiếp cận mức chi phí hợp lý.",
        },
        {
          title: "Cách mạng hóa ngành bán lẻ với AI Tạo sinh bảo mật tuyệt đối",
          text: '"The Turk" là giải pháp chatbot và callbot AI được thiết kế riêng, vận hành trên nền tảng Amazon Bedrock, nhằm mang đến trải nghiệm khách hàng chân thực, bảo mật và cá nhân hóa cho ngành thương mại điện tử.',
        },
      ],
    },
    cta: {
      title: "Sẵn sàng “Lên mây” cùng Cloudino?",
      text: "Đối tác AWS Well\u2011Architected đầu tiên tại Việt\u00A0Nam",
      subtext:
        "Chúng tôi hỗ trợ khách hàng của mình áp dụng những phương pháp thực hành tốt nhất cho cơ sở hạ tầng của họ, dựa trên sáu trụ cột: hoạt động xuất sắc, bảo mật, độ tin cậy, hiệu quả hoạt động, tối ưu chi phí và tính bền vững.",
    },
    stats: [
      {
        value: "1000+",
        label: "Khách hàng doanh nghiệp",
      },
      { value: "200K+", label: "Tài khoản đã đăng ký" },
      { value: "900+", label: "Dự án" },
    ],
    bottomCta: {
      text: "Đối tác AWS Well\u2011Architected đầu tiên tại Việt\u00A0Nam",
      subtext: "Sẵn sàng “Lên mây” cùng Cloudino?",
    },
  },
  {
    platform: "digital-ocean",
    title: "Digital Ocean",
    subtitle:
      "Cloudino là đối tác chiến lược của DigitalOcean tại Việt\u00A0Nam — giúp doanh nghiệp triển khai hạ tầng cloud nhanh hơn, với chi phí minh bạch và hỗ trợ thương mại địa phương.",
    button: "TƯ VẤN NGAY",
    aboutUs: {
      title: "VỀ CHÚNG TÔI",
      text: "Cloudino được thành lập với một sứ mệnh rõ ràng: giúp doanh nghiệp Việt\u00A0Nam tiếp cận hạ tầng cloud toàn cầu một cách đơn giản, minh bạch và có người đồng hành thực sự.",
      subtext:
        "Chúng tôi không chỉ bán license. Chúng tôi tư vấn đúng giải pháp, hỗ trợ triển khai, và ở lại cùng bạn khi doanh nghiệp lớn lên.",
      cards: [
        {
          title: "GenAI Launchpad",
          text: "Template sẵn có để bắt đầu AI app trong vài phút",
        },
        {
          title: "Model Inference",
          text: "Gọi AI models qua API — không cần GPU",
        },
        {
          title: "Agent Platform",
          text: "Deploy AI agents tự động hóa quy trình, tích hợp hệ thống hiện tại",
        },
      ],
      cta: {
        title: "",
        text: "600,000+ Developers dùng DigitalOcean toàn cầu",
        subtext: "",
      },
    },
    features: {
      cards: [
        {
          title: "Bộ dịch vụ nền tảng hoàn chỉnh",
          text: "Dịch vụ linh hoạt, tích hợp toàn bộ giải pháp cho các nhu cầu điện toán, mạng, lưu trữ và cơ sở dữ liệu của ứng dụng",
          image: "/images/homepage/digitalOcean (1).png",
        },
        {
          title: "Nền tảng tích hợp AI",
          text: "Cung cấp khả năng truy cập liền mạch vào các GPU và TPU mạnh mẽ cùng với các công cụ và dịch vụ AI toàn diện.",
          image: "/images/homepage/digitalOcean (2).jpg",
        },
        {
          title: "Hệ thống quản lý nội dung (CMS)",
          text: "Nền tảng thương mại điện tử, khung phát triển ứng dụng web và công cụ dành cho nhà phát triển để đẩy nhanh quá trình xây dựng ứng dụng.",
          image: "/images/homepage/digitalOcean (1).jpg",
        },
      ],
    },
    cta: {
      title: "",
      text: "Hơn cả một nhà phân phối — chúng tôi là đội ngũ đảm bảo DigitalOcean hoạt động đúng cho doanh nghiệp của bạn tại Việt\u00A0Nam.",
      subtext: "",
    },
    stats: [
      {
        value: "1000+",
        label: "Khách hàng doanh nghiệp",
      },
      { value: "200K+", label: "Tài khoản đã đăng ký" },
      { value: "900+", label: "Dự án" },
    ],
    bottomCta: {
      text: "Giải pháp đám mây tiết kiệm, phù hợp cho doanh nghiệp",
      subtext: "",
    },
  },
  {
    platform: "lark",
    title: "Larksuite",
    subtitle:
      "Cloudino là Đối tác chiến lược Platinum của LarkSuite tại Việt\u00A0Nam — đồng hành cùng doanh nghiệp kiến tạo không gian làm việc số toàn diện, triển khai nhanh chóng với chi phí minh bạch và dịch vụ hỗ trợ nội địa tận tâm.",
    button: "TƯ VẤN NGAY",
    aboutUs: {
      title: "VỀ CHÚNG TÔI",
      text: "Cloudino được thành lập với một sứ mệnh rõ ràng: giúp doanh nghiệp Việt\u00A0Nam tiếp cận nền tảng làm việc số toàn cầu một cách đơn giản, minh bạch và có người đồng hành thực sự.",
      subtext:
        "Chúng tôi không chỉ bán license. Chúng tôi tư vấn đúng giải pháp, hỗ trợ triển khai, và ở lại cùng bạn khi doanh nghiệp lớn lên.",
      cards: [
        {
          title: "Lark Messenger",
          text: "Nền tảng giao tiếp trung tâm, hỗ trợ chat nhóm quy mô lớn, phân luồng tin nhắn (threads) thông minh và bảo mật cấp doanh nghiệp.",
        },
        {
          title: "Lark Meetings",
          text: "Giải pháp họp trực tuyến mượt mà hỗ trợ lên đến 1,000 người tham gia, tích hợp chia sẻ màn hình và đồng chỉnh sửa tài liệu ngay trong cuộc họp.",
        },
        {
          title: "Lark Base AI & Smart Search",
          text: "AI phân tích và tự động tạo bảng biểu, biểu đồ từ dữ liệu thô trong Lark Base. Đồng thời, công cụ tìm kiếm thông minh giúp trích xuất tức thì thông tin từ tin nhắn, tài liệu trên toàn bộ hệ thống.",
        },
      ],
      cta: {
        title: "Implementation & Advisory",
        text: "Đội ngũ chuyên gia sẽ phân tích quy trình thực tế để tư vấn cách thiết lập LarkSuite chuẩn xác nhất, đảm bảo nhân sự của bạn dễ dàng thích ứng và ứng dụng hiệu quả.",
        subtext: "",
      },
    },
    features: {
      cards: [
        {
          title: "Đối tác chiến lược bậc cao nhất",
          text: "Cloudino làm việc trực tiếp với hãng — mang đến cho bạn chính sách giá tốt nhất, đặc quyền hỗ trợ ưu tiên và cơ hội tiếp cận sớm các tính năng mới.",
          image: "/images/homepage/lark (1).png",
        },
        {
          title: "Hỗ trợ thanh toán nội địa",
          text: "Thanh toán bằng VND, xuất hóa đơn VAT hợp lệ đầy đủ — không cần thẻ ngoại tệ hay đau đầu với thủ tục thanh toán quốc tế. Chúng tôi xử lý mọi hồ sơ thương mại để đội ngũ kế toán của bạn luôn an tâm.",
          image: "/images/homepage/lark (2).png",
        },
        {
          title: "Đồng hành phát triển dài hạn",
          text: "Có ngay một đầu mối hỗ trợ chuyên trách trực tiếp bằng tiếng Việt. Chúng tôi liên tục đồng hành đào tạo và tối ưu hệ thống khi doanh nghiệp mở rộng quy mô — cam kết thành công cùng bạn trong dài hạn.",
          image: "/images/homepage/lark (1).png",
        },
      ],
    },
    cta: {
      title: "",
      text: "Hơn cả một nhà phân phối — chúng tôi là đội ngũ chuyên gia đảm bảo LarkSuite được triển khai tối ưu và giải quyết đúng bài toán vận hành của doanh nghiệp bạn tại Việt\u00A0Nam.",
      subtext: "",
    },
    stats: [
      {
        value: "1000+",
        label: "Khách hàng doanh nghiệp",
      },
      { value: "200K+", label: "Tài khoản đã đăng ký" },
      { value: "900+", label: "Dự án" },
    ],
    bottomCta: {
      text: "Mọi công cụ bạn cần - Tất cả trong một nền tảng duy nhất",
      subtext: "",
    },
  },
];

const { platform } = Astro.params;

const page = pages.find((page) => page.platform === platform);
if (!page) return Astro.redirect("/404");
---

<Layout title={`${page.title} | Cloudino`}>
  <main class="tracking-tighter bg-black">
    {/* Hero */}
    <section
      class="relative flex h-auto min-h-[460px] py-16 sm:py-24 lg:h-[930px] items-center overflow-hidden bg-black"
    >
      <img
        src="/images/backgrounds/AICC.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-25 sm:opacity-50 mix-blend-screen filter brightness-90 sm:brightness-125 pointer-events-none"
      />
      <img
        src="/images/backgrounds/M&M.gif"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-20 sm:opacity-40 mix-blend-screen filter brightness-90 sm:brightness-125 pointer-events-none"
      />
      <div
        class="relative mx-auto w-full max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px] text-center z-10"
      >
        <div class="mx-auto max-w-[1519px]">
          <h1
            class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl 2xl:text-[128px] font-extrabold leading-tight text-transparent bg-clip-text tracking-tight uppercase"
            style="background-image:linear-gradient(45deg,#5B6FF5,#D4CB7B 52.6%,#DA3FF0)"
          >
            {page.title}
          </h1>
          <p
            class="mt-4 sm:mt-6 mx-auto max-w-[740px] text-xs sm:text-sm md:text-base lg:text-lg font-normal text-white/80 leading-relaxed"
          >
            {page.subtitle}
          </p>
          <a
            href="/contact"
            class="mt-6 sm:mt-8 mx-auto inline-flex h-[46px] sm:h-[60px] w-[160px] sm:w-[201px] items-center justify-center rounded-full border border-accent text-sm sm:text-base font-normal tracking-[-1px] text-white backdrop-blur-md transition-all hover:bg-white hover:text-accent bg-accent/40 shadow-[0_0_25px_rgba(125,81,211,0.4)] hover:scale-105"
          >
            {page.button} →
          </a>
        </div>
      </div>
    </section>

    {/* Customer Success Story 1 */}
    <section class="relative bg-black py-8 sm:py-16">
      <img
        src="/images/backgrounds/image119.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-80 mix-blend-screen filter brightness-125 pointer-events-none"
      />
      <div
        class="relative mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]"
      >
        <div
          class="flex flex-col lg:flex-row items-center justify-between gap-6 lg:gap-10 rounded-2xl sm:rounded-3xl lg:rounded-4xl p-6 sm:p-10 lg:p-16 text-center lg:text-left"
          style="background:linear-gradient(135deg,rgba(49,46,129,0.3),rgba(125,81,211,0.15))"
        >
          <div
            class="flex-1 flex flex-col justify-start items-center lg:items-start max-w-[870px] my-auto"
          >
            {
              page.aboutUs.title && (
                <p class="text-xs sm:text-base font-normal text-white/70 uppercase tracking-wider">
                  {page.aboutUs.title}
                </p>
              )
            }
            <h2
              class="mt-2 text-lg sm:text-2xl lg:text-3xl xl:text-4xl font-light text-white leading-snug"
            >
              {page.aboutUs.text}
            </h2>
            <p
              class="mt-3 sm:mt-4 text-xs sm:text-sm lg:text-base font-normal text-white/70 max-w-[548px]"
            >
              {page.aboutUs.subtext}
            </p>
          </div>
          <img
            src="/images/icons/image 141.png"
            alt=""
            class="h-[160px] w-[160px] sm:h-[300px] sm:w-[300px] lg:h-[480px] lg:w-[480px] shrink-0 object-contain mx-auto lg:mx-0"
          />
        </div>
      </div>
    </section>

    {/* Feature Cards */}
    <section class="bg-black py-6 sm:py-12">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 lg:gap-10"
        >
          {
            page.aboutUs.cards.map((card, i) => (
              <div class="h-auto min-h-[180px] sm:min-h-[240px] w-full rounded-2xl border border-white/10 p-5 sm:p-8 backdrop-blur-sm bg-linear-to-r from-[#312E81] to-accent flex flex-col justify-center text-center">
                <h3 class="text-lg sm:text-xl lg:text-2xl font-normal text-white text-center tracking-tight leading-snug">
                  {card.title}
                </h3>
                <p class="mt-2.5 sm:mt-3 text-xs sm:text-sm lg:text-base font-normal text-white/80 text-center leading-relaxed">
                  {card.text}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Customer Success Story 2 */}
    <section class="bg-black py-8 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <div class="max-w-[870px] text-center lg:text-left mx-auto lg:mx-0">
          {
            page.aboutUs.cta.title && (
              <p class="text-xs sm:text-base font-normal text-white/70 uppercase tracking-wider">
                {page.aboutUs.cta.title}
              </p>
            )
          }
          <h2
            class="mt-2 text-[clamp(1.25rem,5vw,3rem)] font-light text-white leading-snug"
          >
            {page.aboutUs.cta.text}
          </h2>
          <p
            class="mt-3 sm:mt-4 text-[clamp(0.75rem,2vw,1rem)] font-normal text-white/70 max-w-[548px] mx-auto lg:mx-0"
          >
            {page.aboutUs.cta.subtext}
          </p>
        </div>
      </div>
    </section>

    {/* Solution Cards */}
    <section class="bg-black py-8 sm:py-16 lg:py-24">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6 lg:gap-8"
        >
          {
            page.features.cards.map(
              (card: { title: string; text: string; image?: string }, i) => {
                const platformImages = [
                  "/images/solutionPlatforms/ManagedServices.png",
                  "/images/solutionPlatforms/AWS_Billing.png",
                  "/images/solutionPlatforms/AI.png",
                ];
                const imageSrc =
                  card.image || platformImages[i % platformImages.length];
                return (
                  <div
                    class="group rounded-2xl sm:rounded-[28px] border border-purple-400/50 p-5 sm:p-8 flex flex-col justify-between backdrop-blur-xl shadow-[0_0_30px_rgba(147,51,234,0.25)] transition-all duration-300 hover:border-purple-300 hover:shadow-[0_0_45px_rgba(168,85,247,0.45)] hover:-translate-y-1"
                    style="background: linear-gradient(135deg, rgba(55, 38, 115, 0.65) 0%, rgba(26, 16, 60, 0.85) 100%);"
                  >
                    <div class="h-[160px] sm:h-[220px] w-full overflow-hidden rounded-xl mb-4 sm:mb-5 border border-white/10 shadow-md">
                      <div
                        class="h-full w-full bg-cover bg-center transition-transform duration-500 group-hover:scale-105"
                        style={`background-image: url('${imageSrc}');`}
                      />
                    </div>
                    <div class="flex-1 flex flex-col text-center">
                      <h3 class="text-lg sm:text-xl lg:text-2xl font-bold text-white leading-snug tracking-tight group-hover:text-purple-200 transition-colors">
                        {card.title}
                      </h3>
                      <p class="mt-2.5 sm:mt-3 text-xs sm:text-sm lg:text-base font-normal text-white/80 leading-relaxed">
                        {card.text}
                      </p>
                    </div>
                  </div>
                );
              },
            )
          }
        </div>
      </div>
    </section>

    {/* Customer Success Story 3 - image left, text right */}
    <section class="relative bg-black py-8 sm:py-16">
      <img
        src="/images/backgrounds/image119.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-80 mix-blend-screen filter brightness-125 pointer-events-none"
      />
      <div
        class="relative mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]"
      >
        <div
          class="flex flex-col-reverse lg:flex-row items-center justify-between gap-6 lg:gap-10 rounded-2xl p-6 sm:p-10 lg:p-16 text-center lg:text-right bg-accent/40 border border-accent"
        >
          <img
            src="/images/hero/hero-graphic.png"
            alt=""
            class="h-[160px] w-[160px] sm:h-[300px] sm:w-[300px] lg:h-[480px] lg:w-[480px] shrink-0 object-contain mx-auto lg:mx-0"
          />
          <div class="flex-1 max-w-[870px]">
            {
              page.cta.title && (
                <p class="text-xs sm:text-base font-normal text-white/70 uppercase tracking-wider">
                  {page.cta.title}
                </p>
              )
            }
            <h2
              class="mt-2 text-lg sm:text-2xl lg:text-3xl xl:text-4xl font-light text-white leading-snug"
            >
              {page.cta.text}
            </h2>
            <p
              class="mt-3 sm:mt-4 text-xs sm:text-sm lg:text-base font-normal text-white/70 max-w-[548px] lg:ml-auto"
            >
              {page.cta.subtext}
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Case Stories */}
    <CaseStoriesSection />

    {/* Stats */}
    <section class="bg-black py-8 sm:py-16">
      <div class="mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px]">
        <Stats stats={page.stats} />
      </div>
    </section>

    {/* CTA - Spaced out cleanly from Footer (pb-24 sm:pb-36 lg:pb-48) */}
    <section
      class="relative bg-black py-12 sm:py-24 pb-20 sm:pb-36 lg:pb-48 overflow-hidden"
    >
      <img
        src="/images/backgrounds/image119.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-80 mix-blend-screen filter brightness-125 pointer-events-none"
      />
      <PurpleOrb size={500} blur={160} opacity={0.4} client:load />
      <div
        class="relative mx-auto max-w-[1920px] px-4 sm:px-8 md:px-10 lg:px-12 xl:px-16 2xl:px-[285px] text-center z-10"
      >
        <div
          class="mx-auto max-w-[1258px] flex flex-col items-center justify-center text-center"
        >
          <h2
            class="mt-2 text-lg sm:text-2xl lg:text-3xl xl:text-4xl font-light text-white text-center leading-snug"
          >
            {page.bottomCta.text}
          </h2>
          {
            page.bottomCta.subtext && (
              <p class="mt-3 sm:mt-4 mx-auto max-w-[548px] text-xs sm:text-sm lg:text-base font-normal text-white/70 text-center">
                {page.bottomCta.subtext}
              </p>
            )
          }
          <a
            href="/contact"
            class="mt-6 sm:mt-8 mx-auto inline-flex h-[46px] sm:h-[60px] w-[160px] sm:w-[201px] items-center justify-center rounded-full border border-purple-400/50 text-sm sm:text-base font-medium tracking-[-0.5px] text-white backdrop-blur-xl bg-gradient-to-r from-[#312e81] via-[#5b3db5] to-[#7d51d3] hover:bg-white hover:text-[#201048] shadow-[0_0_25px_rgba(168,85,247,0.45)] hover:shadow-[0_0_35px_rgba(168,85,247,0.75)] transition-all duration-300 hover:scale-105"
          >
            {page.button} →
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
