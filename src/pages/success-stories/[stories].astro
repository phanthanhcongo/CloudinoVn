---
import Layout from "../../layouts/Layout.astro";
import SuccessStoryDetail from "../../components/SuccessStoryDetail.astro";

export function getStaticPaths() {
  return [
    { params: { stories: "1" } },
    { params: { stories: "2" } },
    { params: { stories: "3" } },
    { params: { stories: "4" } },
    { params: { stories: "5" } },
  ];
}

const { stories } = Astro.params;

const cases = [
  {
    id: "1",
    image: "/images/backgrounds/ViMeeting+.jpg",
  },
  {
    id: "2",
    image: "/images/backgrounds/MaxcomGroup.jpg",
  },
  {
    id: "3",
    image: "/images/backgrounds/Masan.jpg",
  },
  {
    id: "4",
    image: "/images/backgrounds/De Heus Việt Nam.jpg",
  },
  {
    id: "5",
    image: "/images/backgrounds/Urbox.jpg",
  },
];

const details = Object.values(
  import.meta.glob("../../success-stories/*.md", { eager: true }),
);

const page = details.find((page: any) => {
  return page.frontmatter.id === stories;
}) as any;

if (!page) return Astro.redirect("/404");

const compiled = await page.compiledContent();
const currentCase = cases.find((c) => c.id === stories);
---

<Layout title={`${page.frontmatter.name || "Success Story"} | Cloudino`}>
  <SuccessStoryDetail
    name={page.frontmatter.name}
    title={page.frontmatter.title}
    subtitle={page.frontmatter.subtitle}
    image={currentCase?.image || page.frontmatter.image}
    compiledContent={compiled}
  />
</Layout>
