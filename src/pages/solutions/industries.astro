---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Solutions - Industries | Cloudino">
  <main class="pt-[101px] bg-black">
    <section class="py-[137px]">
      <div class="mx-auto max-w-[1920px] px-[285px]">
        <h1 class="text-[96px] font-light text-white">Solutions</h1>
        <p class="mt-0 max-w-2xl text-base text-white/60">
          lorem ipsum dolor sit amet consectetuer adipiscing elit sed diam
        </p>
        <div class="mt-[120px] grid grid-cols-4 gap-4">
          {["Healthcare", "Finance", "Public Sector", "Gaming", "Telco & Media", "Software", "Retail", "Manufacturing"].map((i) => (
            <div class="rounded-xl border border-white/10 px-8 py-10 text-center text-base text-white/80 transition-colors hover:border-primary/40 hover:text-white">
              {i}
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
